#!/usr/bin/env python3
"""structcheck: the structure layer of slopcheck. Parse-based signals for prose, reported as named breaks.

Runs in its own venv (spaCy and an English model, nltk WordNet, optional torch for GPT-2 surprisal).
slopcheck calls it as a subprocess with --stdin --json. It never talks to the network: the HF offline
flags are set below, so a missing model is an error, never a download.

Usage:
  structcheck FILE | --stdin   [--json] [--model en_core_web_sm] [--surprisal] [--surprisal-model gpt2]
  structcheck --selftest [--surprisal]

Input is markdown or plain prose, blocks separated by blank lines. Code, links and frontmatter are dropped.
Headings, table rows and label lines ending in a colon are skipped, bullet markers are removed, sentences
under 4 words too. Quoted spans ("like this") are mentions, not prose, and become a placeholder noun before
parsing. A short bullet or a short bold lead line (under 15 words) may have no verb: those are labels.

Rules, each a named break with a severity. slopcheck decides which ones deny an outward send.
  hard      parse-failure (the parser found no well-formed reading), no-verb, no-finite-verb, fragment,
            appositive-wedged, appositive-in-list, noun-pile (4 or more nouns in a row),
            heavy-subject (7 or more words before the verb)
  advisory  center-embedding (a clause with no "that" or comma between subject and verb),
            zero-relative (object-extracted, "the items this work needs"), subject-verb-gap, passive,
            bare-present-plan ("lands before the upgrade", no modal), ambiguous-subordinator ("now, while"),
            adverb-as-modifier ("a now value"), bare-noun-subject ("Owner lane names"),
            surprisal-spike (with --surprisal, at most 8 per text)
Rules that fired as often on good text as on bad in the 54-pair study are not reported:
prepositional attachment, coined hyphen compounds, three-noun piles, announced center-embedding.
Exit codes: 0 clean, 1 advisory only, 2 hard breaks. Errors print one line to stderr and exit 3.
"""
import sys, os, re, json, time, math, argparse

VENV = os.path.expanduser(os.environ.get("SLOPCHECK_STRUCTURE_VENV", "~/.local/share/slopcheck/venv"))
try:
    import spacy  # noqa: F401
except ImportError:
    _py = os.path.join(VENV, "bin", "python")
    if os.path.exists(_py) and os.path.realpath(sys.prefix) != os.path.realpath(VENV):
        os.execv(_py, [_py, os.path.realpath(__file__)] + sys.argv[1:])   # run from the layer's venv
    print(f"structcheck: spaCy is not installed and no venv at {VENV}. Run: slopcheck install-structure", file=sys.stderr)
    sys.exit(3)

os.environ.setdefault("HF_HUB_OFFLINE", "1")
os.environ.setdefault("TRANSFORMERS_OFFLINE", "1")
os.environ.setdefault("TOKENIZERS_PARALLELISM", "false")

RELATIVIZERS = {"that", "which", "who", "whom", "whose", "where", "when", "why"}
TIME_ADV = {"now", "then", "today", "tomorrow", "currently", "still", "yet", "already", "soon", "later", "meanwhile"}
TIME_PREP = {"before", "after", "until", "by"}
AMBIG_SUB = {"while", "since", "as", "once"}
FOCUS_ADV = {"only", "even", "also", "just", "almost", "about", "nearly", "mostly", "not", "never", "ever", "exactly", "already", "still", "yet"}
HARD = {"parse-failure", "no-verb", "no-finite-verb", "fragment", "appositive-wedged", "appositive-in-list",
        "noun-pile", "heavy-subject"}
PLACEHOLDER = "Zed"            # a quoted span becomes one proper noun, which the parser treats as a plain argument
SHORT_BULLET = 15              # bullets and bold lead lines under this many words may be verbless
SPIKE_BITS = 16                # a surprisal spike is above this and above the sentence's mean + 1.5 sd
SPIKES_PER_TEXT = 8
APPOSITIVE_MIN_WORDS = 3       # "my friend Bob" costs nothing, "the SQL steps that turn events into rows" does
SELFTEST_SENTENCE = "Items this work needs ship now, while scalar-only items are hints for Q1 with no owners and no tickets."


# ---------------- resources ----------------
def load_spacy(model):
    import spacy
    return spacy.load(model, disable=["ner"])


def load_wordnet():
    try:
        import nltk
        nltk.data.path.insert(0, os.path.join(sys.prefix, "nltk_data"))
        from nltk.corpus import wordnet as wn
        wn.synsets("test")
        return wn
    except Exception:
        return None


# ---------------- text ----------------
def unmark(text):
    """Markdown to prose, keeping paragraph breaks and bold markers (blocks() reads the lead line from them)."""
    text = re.sub(r"\A---\n.*?\n---\n", "", text, count=1, flags=re.S)
    text = re.sub(r"```.*?```", " ", text, flags=re.S)
    text = re.sub(r"`[^`\n]*`", " " + PLACEHOLDER + " ", text)   # a command or a path is a noun
    text = re.sub(r"!\[[^\]]*\]\([^)]*\)", " ", text)
    text = re.sub(r"\[([^\]]*)\]\([^)]*\)", r"\1", text)
    return re.sub(r"https?://\S+", " url ", text)


def split_lead(text, kind):
    """A block that opens with a bold span is a lead line plus the rest. Emphasis markers are then dropped."""
    m = re.match(r"^\*\*(.{1,200}?)\*\*\s*(.*)$", text, re.S)
    parts = [(m.group(1), "lead"), (m.group(2), kind)] if m else [(text, kind)]
    return [(re.sub(r"\*\*|__|(?<!\w)\*(?!\s)|(?<!\s)\*(?!\w)", "", t).strip(), k) for t, k in parts if t.strip()]


def unquote(text):
    """A quoted span is a mention, not prose: replace it with one proper noun so the parser sees a plain argument."""
    text = re.sub(r"[\u201c\"][^\u201d\"\n]{1,80}[\u201d\"]", PLACEHOLDER, text)
    return re.sub(r"(?<![A-Za-z])[\u2018'][^\u2019'\n]{1,40}[\u2019'](?![A-Za-z])", PLACEHOLDER, text)


def blocks(text):
    """Markdown or prose into checkable (text, kind) blocks, kind in para, bullet, lead. Headings, table rows and short colon labels are skipped."""
    out = []
    for block in re.split(r"\n\s*\n+", unmark(text)):
        lines = [l.strip() for l in block.split("\n") if l.strip()]
        buf = []
        for line in lines:
            if line.startswith("#") or re.match(r"^\|.*\|$", line):
                continue
            m = re.match(r"^([-*•]|\d+[.)])\s+(.*)$", line)
            if m:
                if buf:
                    out += split_lead(" ".join(buf), "para")
                    buf = []
                out += split_lead(m.group(2), "bullet")
            else:
                buf.append(line)
        if buf:
            joined = " ".join(buf)
            if joined.endswith(":") and len(joined.split()) <= 12:
                continue
            out += split_lead(joined, "para")
    return [(unquote(b), kind) for b, kind in out if len(re.findall(r"[A-Za-z]+", b)) >= 4]


def words(tokens):
    return " ".join(t.text for t in tokens if not t.is_punct)


def subtree_len(tok):
    excl = set()
    for c in tok.subtree:
        if c is not tok and c.dep_ in ("conj", "cc"):
            excl.update(x.i for x in c.subtree)
    return sum(1 for w in tok.subtree if not w.is_punct and w.i not in excl)


def clause_verb(tok):
    h = tok
    while h.head.i != h.i and h.pos_ not in ("VERB", "AUX"):
        h = h.head
    return h


# ---------------- rules ----------------
def r_wellformed(sent, is_label=False):
    out = []
    for t in sent:
        subs = [c for c in t.children if c.dep_ in ("nsubj", "nsubjpass")]
        if len(subs) > 1:
            out.append(("parse-failure", f"the parser gave '{t.text}' two subjects ({', '.join(c.text for c in subs)}), it found no well-formed reading"))
    finite = [t for t in sent if t.tag_ in ("VBZ", "VBP", "VBD", "MD")]
    root = sent.root
    label = any(w.text == ":" for w in sent)
    if is_label and len(re.findall(r"[A-Za-z]+", sent.text)) < SHORT_BULLET:
        return out                      # a short list item or lead line may be a noun phrase
    if root.pos_ not in ("VERB", "AUX") and not label:
        note = f", its only finite verb '{finite[0].text}' sits inside a clause, or the parser misread a verb as a noun" if finite else ""
        out.append(("no-verb", f"no main verb, the sentence rests on '{root.text}' ({root.pos_.lower()}){note}"))
    elif root.pos_ in ("VERB", "AUX") and not finite and root.tag_ != "VB":
        out.append(("no-finite-verb", f"no finite verb, the main word is '{root.text}' ({root.tag_})"))
    elif root.tag_ in ("VBZ", "VBD") and not any(c.dep_ in ("nsubj", "nsubjpass", "expl", "csubj") for c in root.children):
        out.append(("fragment", f"the finite verb '{root.text}' has no subject"))   # a VBP root with no subject is usually an imperative the tagger missed
    return out


def r_subject_verb(sent):
    out = []
    for t in sent:
        if t.dep_ in ("nsubj", "nsubjpass") and t.head.pos_ in ("VERB", "AUX") and t.i < t.head.i:
            v = t.head
            own_aux = {c.i for c in v.children if c.dep_ in ("aux", "auxpass", "neg")}
            between = [w for w in sent if t.i < w.i < v.i and w.i not in own_aux and not w.is_punct]
            appos = [c for c in t.children if c.dep_ == "appos" and t.i < c.i < v.i and subtree_len(c) >= APPOSITIVE_MIN_WORDS]
            if appos:
                out.append(("appositive-wedged", f"the appositive '{words(appos[0].subtree)}' sits between the subject '{t.text}' and its verb '{v.text}'"))
            else:
                verbs = [w for w in between if w.pos_ in ("VERB", "AUX")]
                if verbs:
                    announced = any(w.lower_ in RELATIVIZERS or w.dep_ == "mark" for w in between) or (t.i + 1 < len(sent.doc) and sent.doc[t.i + 1].text == ",")
                    if not announced:
                        out.append(("center-embedding", f"the subject '{t.text}' and its verb '{v.text}' are split by a clause with no 'that' or comma ('{words(between)}')"))
                elif len(between) >= 4:
                    out.append(("subject-verb-gap", f"{len(between)} words between '{t.text}' and '{v.text}' ('{words(between)}')"))
            n = subtree_len(t)
            if n >= 7:
                out.append(("heavy-subject", f"the subject of '{v.text}' is {n} words: '{words(t.subtree)}'"))
    return out


def r_appositive_other(sent):
    out = []
    for a in sent:
        if a.dep_ != "appos":
            continue
        h = a.head
        if h.dep_ in ("nsubj", "nsubjpass") and a.i < h.head.i:
            continue
        if subtree_len(a) < APPOSITIVE_MIN_WORDS:
            continue
        span = words(a.subtree)
        if h.dep_ == "conj" or any(c.dep_ == "conj" for c in h.children) or any(c.dep_ == "conj" for c in a.children):
            out.append(("appositive-in-list", f"the appositive '{span}' sits inside a list around '{h.text}'"))
            continue
        v = clause_verb(h)
        inside = {w.i for w in a.subtree}
        last = max(inside)
        after = [w for w in sent if w.i > last and not w.is_punct and w.i not in inside
                 and v.i in {x.i for x in w.ancestors}
                 and not any(x.dep_ in ("advcl", "ccomp", "relcl", "conj") for x in [w] + [y for y in w.ancestors if y.i > v.i])]
        if after:
            out.append(("appositive-wedged", f"the appositive '{span}' sits between '{v.text} ... {h.text}' and '{words(after[:3])} ...'"))
    return out


def r_zero_relative(sent):
    out = []
    for t in sent:
        if t.dep_ == "relcl":
            rel = [w for w in t.subtree if w.lower_ in RELATIVIZERS and w.tag_ in ("WDT", "WP", "WP$", "WRB")]
            if not rel and any(c.dep_ in ("nsubj", "nsubjpass") for c in t.children):
                out.append(("zero-relative", f"'{t.head.text} ... {t.text}' is a relative clause with its own subject and no 'that' or 'which'"))
    return out


def r_passive(sent):
    return [("passive", f"'{t.text} {t.head.text}'") for t in sent if t.dep_ == "auxpass"]


def r_bare_present(sent):
    root = sent.root
    if root.pos_ != "VERB" or root.tag_ not in ("VBP", "VBZ"):
        return []
    if any(c.dep_ in ("aux", "auxpass") for c in root.children):
        return []
    trig = [c for c in root.children if c.dep_ == "prep" and c.lower_ in TIME_PREP]
    if trig:
        return [("bare-present-plan", f"'{root.text} ... {trig[0].text}' has no modal, a rule written as a prediction")]
    return []



def r_subordinator(sent):
    out = []
    for t in sent:
        if t.lower_ in AMBIG_SUB and t.dep_ in ("mark", "advmod", "prep"):
            left = [w for w in sent if w.i < t.i and not w.is_punct]
            primed = [w.text for w in left[-3:] if w.lower_ in TIME_ADV]
            if primed:
                out.append(("ambiguous-subordinator", f"'{t.text}' reads as time or as contrast, and '{' '.join(primed)}' just before it primes the time reading"))
    return out


def r_noun_pile(sent):
    out = []
    for t in sent:
        if t.pos_ in ("NOUN", "PROPN") and t.dep_ != "compound":
            chain, j, heads = [], t.i - 1, {t.i}
            while j >= sent.start and sent.doc[j].dep_ == "compound" and sent.doc[j].head.i in heads:
                chain.append(sent.doc[j])
                heads.add(j)
                j -= 1
            if len(chain) >= 3:
                out.append(("noun-pile", f"'{words(reversed(chain))} {t.text}' is {len(chain) + 1} nouns in a row"))
    return out


def r_adverb_modifier(sent):
    out = []
    for t in sent:
        if t.pos_ == "ADV" and t.lower_ not in FOCUS_ADV and t.head.pos_ in ("NOUN", "PROPN") and t.i == t.head.i - 1 \
                and t.dep_ in ("advmod", "amod", "compound", "npadvmod", "nmod"):
            out.append(("adverb-as-modifier", f"the adverb '{t.text}' is used as a modifier in '{t.text} {t.head.text}'"))
    return out




def r_bare_noun_subject(sent):
    out = []
    for t in sent:
        if t.dep_ in ("nsubj", "nsubjpass") and t.tag_ == "NN" and any(c.dep_ == "compound" for c in t.children) \
                and not any(c.dep_ in ("det", "poss", "nummod") for c in t.children):
            out.append(("bare-noun-subject", f"the singular subject '{words(t.subtree)}' has no article"))
    return out


def homographs(sent, wn):
    if wn is None:
        return []
    out = []
    for t in sent:
        if t.is_alpha and t.pos_ in ("NOUN", "VERB", "ADJ", "ADV", "PROPN"):
            n = wn.synsets(t.lemma_, pos="n") or wn.synsets(t.lower_, pos="n")
            v = wn.synsets(t.lemma_, pos="v") or wn.synsets(t.lower_, pos="v")
            if n and v:
                out.append(t.text)
    return out


# ---------------- surprisal (optional) ----------------
class Surprisal:
    """Per-word surprisal in bits under a local causal LM. A word's surprisal is the max over its BPE pieces."""
    def __init__(self, name="gpt2"):
        import torch
        from transformers import AutoTokenizer, AutoModelForCausalLM
        self.torch = torch
        self.tok = AutoTokenizer.from_pretrained(name)
        self.model = AutoModelForCausalLM.from_pretrained(name).eval()
        self.name = name

    def words(self, text):
        torch = self.torch
        ids = self.tok(self.tok.bos_token + text, return_tensors="pt").input_ids[:, :1024]
        with torch.no_grad():
            logits = self.model(ids).logits
        lp = torch.log_softmax(logits[0, :-1].float(), -1)
        tgt = ids[0, 1:]
        bits = (-lp[torch.arange(len(tgt)), tgt] / math.log(2)).tolist()
        pieces = self.tok.convert_ids_to_tokens(tgt)
        out = []
        for p, b in zip(pieces, bits):
            s = p.replace("Ġ", " ")
            if s.startswith(" ") or not out:
                out.append([s.strip(), b])
            else:
                out[-1][0] += s
                out[-1][1] = max(out[-1][1], b)
        return out, bits

    def spikes(self, text, max_per_sentence=2):
        """Words a reader may stumble on: far above the sentence's own level, plain lowercase words only."""
        ws, bits = self.words(text)
        if len(bits) < 4:
            return [], 0.0
        mean = sum(bits) / len(bits)
        sd = (sum((v - mean) ** 2 for v in bits) / len(bits)) ** 0.5
        cands = []
        for i, (w, b) in enumerate(ws):
            clean = w.strip(".,;:!?\"'()[]")
            if i == 0 or len(clean) < 3 or clean == PLACEHOLDER or not re.fullmatch(r"[A-Za-z][a-z'\-]+", clean):
                continue
            if b > mean + 1.5 * sd and b > SPIKE_BITS:
                cands.append((clean, b))
        cands.sort(key=lambda x: -x[1])
        return cands[:max_per_sentence], mean


# ---------------- driver ----------------
def analyse(nlp, text, wn=None, surprisal=None):
    t0 = time.time()
    breaks, n_sent, homo, means, spikes = [], 0, [], [], []
    for block, kind in blocks(text):
        doc = nlp(block)
        for sent in doc.sents:
            if len(re.findall(r"[A-Za-z]+", sent.text)) < 4:
                continue
            n_sent += 1
            found = []
            found += r_wellformed(sent, kind in ("bullet", "lead"))
            found += r_subject_verb(sent)
            found += r_appositive_other(sent)
            found += r_zero_relative(sent)
            found += r_passive(sent)
            found += r_bare_present(sent)
            found += r_subordinator(sent)
            found += r_noun_pile(sent)
            found += r_adverb_modifier(sent)
            found += r_bare_noun_subject(sent)
            snippet = re.sub(r"\s+", " ", sent.text.strip())[:120]
            if surprisal is not None:
                sp, mean = surprisal.spikes(sent.text)
                means.append(mean)
                spikes += [(b, w, snippet) for w, b in sp]
            for rule, msg in found:
                breaks.append({"rule": rule, "msg": msg, "severity": "hard" if rule in HARD else "advisory", "sentence": snippet})
            homo += homographs(sent, wn)
    for b, w, snippet in sorted(spikes, key=lambda x: -x[0])[:SPIKES_PER_TEXT]:
        breaks.append({"rule": "surprisal-spike", "msg": f"'{w}' at {b:.0f} bits, a reader may stumble here", "severity": "advisory", "sentence": snippet})
    r = {"breaks": breaks, "sentences": n_sent, "noun_verb_homographs": sorted(set(homo))[:20], "_seconds": round(time.time() - t0, 2)}
    if surprisal is not None and means:
        r["surprisal"] = {"model": surprisal.name, "mean_bits": round(sum(means) / len(means), 2)}
    return r


def selftest(args):
    ok = True
    print(f"python {sys.version.split()[0]} at {sys.executable}")
    try:
        import spacy
        print(f"spacy {spacy.__version__}, installed models: {spacy.util.get_installed_models()}")
        nlp = load_spacy(args.model)
        print(f"model {args.model}: loaded")
    except Exception as e:
        print(f"spacy or model {args.model}: FAILED ({type(e).__name__}: {str(e)[:120]})")
        return 1
    wn = load_wordnet()
    print("wordnet:", "loaded" if wn else "missing (homograph and coined-compound signals off)")
    sur = None
    if args.surprisal:
        try:
            sur = Surprisal(args.surprisal_model)
            import torch
            print(f"surprisal: torch {torch.__version__}, {args.surprisal_model} loaded from the local cache")
        except Exception as e:
            print(f"surprisal: FAILED ({type(e).__name__}: {str(e)[:160]})")
            ok = False
    r = analyse(nlp, SELFTEST_SENTENCE, wn, sur)
    rules = sorted({b["rule"] for b in r["breaks"]})
    print(f"test sentence: {len(r['breaks'])} breaks in {r['_seconds']} s: {', '.join(rules)}")
    if "parse-failure" not in rules:
        print("expected a parse-failure on the test sentence and did not get one: FAILED")
        ok = False
    print("selftest:", "ok" if ok else "FAILED")
    return 0 if ok else 1


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("file", nargs="?")
    ap.add_argument("--stdin", action="store_true")
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--model", default="en_core_web_sm")
    ap.add_argument("--surprisal", action="store_true")
    ap.add_argument("--surprisal-model", default="gpt2")
    ap.add_argument("--selftest", action="store_true")
    args = ap.parse_args()
    if args.selftest:
        return selftest(args)
    text = sys.stdin.read() if args.stdin or not args.file else open(args.file, encoding="utf-8", errors="replace").read()
    nlp = load_spacy(args.model)
    wn = load_wordnet()
    sur = Surprisal(args.surprisal_model) if args.surprisal else None
    r = analyse(nlp, text, wn, sur)
    r["_model"] = args.model
    if args.json:
        print(json.dumps(r))
    else:
        hard = [b for b in r["breaks"] if b["severity"] == "hard"]
        print(f"structure: {len(hard)} hard, {len(r['breaks']) - len(hard)} advisory, {r['sentences']} sentences, {r['_seconds']} s")
        for b in r["breaks"]:
            print(f"  - [{b['severity']}] {b['rule']}: {b['msg']}: \"{b['sentence'][:90]}\"")
        if r.get("surprisal"):
            print(f"  surprisal mean {r['surprisal']['mean_bits']} bits per token ({r['surprisal']['model']})")
    hard = any(b["severity"] == "hard" for b in r["breaks"])
    return 2 if hard else (1 if r["breaks"] else 0)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except SystemExit:
        raise
    except Exception as e:
        print(f"structcheck error: {type(e).__name__}: {str(e)[:200]}", file=sys.stderr)
        sys.exit(3)
