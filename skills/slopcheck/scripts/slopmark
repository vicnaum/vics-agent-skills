#!/usr/bin/env python3
"""slopmark: label one span of bad writing so the dataset grows from real complaints.

Usage:
  slopmark "the exact phrase or sentence" THEME [note...]
  slopmark --list

THEME is one word: jargon, wall, tone, long, log, compressed, dash, metaphor, other.
Appends one JSON line to ~/.config/slopcheck/labels.jsonl. Nothing leaves the machine.
"""
import json, os, sys, time
P = os.path.expanduser("~/.config/slopcheck/labels.jsonl")
THEMES = {"jargon", "wall", "tone", "long", "log", "compressed", "dash", "metaphor", "other"}

def main(a):
    if len(a) >= 2 and a[1] == "--list":
        if not os.path.exists(P): print("no labels yet"); return 0
        rows = [json.loads(l) for l in open(P) if l.strip()]
        for r in rows[-30:]: print(f"{r['ts'][:16]}  {r['theme']:10s} {r['span'][:90]}")
        print(f"{len(rows)} labels total"); return 0
    if len(a) < 3:
        print(__doc__); return 1
    span, theme = a[1], a[2].lower()
    if theme not in THEMES:
        print(f"theme must be one of: {', '.join(sorted(THEMES))}"); return 1
    os.makedirs(os.path.dirname(P), exist_ok=True)
    row = {"ts": time.strftime("%Y-%m-%dT%H:%M:%S"), "span": span, "theme": theme, "note": " ".join(a[3:]), "cwd": os.getcwd()}
    open(P, "a").write(json.dumps(row, ensure_ascii=False) + "\n")
    print(f"labelled as {theme}: {span[:80]}"); return 0

if __name__ == "__main__":
    sys.exit(main(sys.argv))
