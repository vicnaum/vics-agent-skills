#!/usr/bin/env bash
# agent-chat — local peer-to-peer chat between Claude Code, OpenAI Codex and
# OpenCode sessions on this machine.
#
# No server: rooms are append-only JSONL files under ~/.claude/agent-chat/rooms/,
# with per-agent read cursors. Registered sessions get unread messages
# auto-delivered: Claude Code and Codex pull them through their hooks
# (UserPromptSubmit, PostToolUse, Stop); OpenCode has them pushed into the
# session by the sender through OpenCode's own server API.
# `nudge` wakes an idle session by typing into its iTerm window (AppleScript).
#
# Rooms (mIRC-style): every agent is a member of its project room (derived from
# the cwd it registered in, like Claude Code's per-folder session storage) and
# of #general. Agents can join/leave/peek other rooms.
#
# Identity is the NAME, not the session: re-registering an existing name from a
# new session (after a fork, strip, or fresh start) silently rebinds it — read
# cursors are kept and no join announcement is made, so to other agents it is
# seamlessly the same agent.
#
# Usage:
#   agent-chat register <name>              join (or silently rebind) as <name>
#   agent-chat send "<msg>" [--room <room>] [--to <name>] [--nudge|--quiet]
#                                           default room: your project room;
#                                           --to = DM, routed to a room you BOTH share (project room
#                                           first, #general only cross-project) — nudges the
#                                           recipient by default (--quiet for FYI-only);
#                                           room posts are passive unless --nudge
#   agent-chat read                         print + consume unread from all your rooms
#   agent-chat log [N] [--room <room>]      last N messages of a room (default: project room)
#   agent-chat rooms                        list all rooms (* = joined)
#   agent-chat join <room> / leave <room>   manage room membership
#   agent-chat peek <room> [N]              read any room without joining (no cursor change)
#   agent-chat who                          list registered agents and their rooms
#   agent-chat status [<name>]              live state of an agent: busy|idle|waiting|dead|offline
#                                           (glyph-primary + hook fallback + process liveness)
#   agent-chat nudge <name> [text] [--force] type a wake-up line + Enter into that agent's terminal
#                                           (refuses while someone types in that pane; --force overrides)
#   agent-chat type <name> "text"           type into that agent's input box WITHOUT submitting
#   agent-chat screen <name> [N]            snapshot of that agent's visible terminal (what it is
#                                           doing right now: spinner, running tool, stuck prompt)
#   agent-chat key <name> <key...>          send keys/shortcuts: escape (stop current work), enter,
#                                           ctrl-c, tab, shift-tab, up/down/left/right, ctrl-b/o/r/t/v...
#                                           e.g. remote slash command: type <n> "/compact" + key <n> enter
#   agent-chat spawn <name> [--dir <path>] [--prompt "task"] [--cmd "claude ..."] [--tab|--pane] [--tmux]
#                                           launch a NEW agent: new iTerm window, --tab = tab in your window,
#                                           --pane = split next to you (or tmux with --tmux / headless),
#                                           reusing this session CLI flags; it registers itself as <name>
#   agent-chat respawn <name> [--prompt "task"] [--report-to <name>] [--dry-run] [--no-wait]
#                       [--force-busy] [--ignore-cooldown] [--cmd "codex ..."]
#                                           replace a tripped/dead codex|claude agent IN PLACE: kill its CLI
#                                           by signal (never types into the tripped chat), start a FRESH
#                                           session in the SAME pane that re-registers as <name>; refuses
#                                           unless the pane provably still holds that agent (no override),
#                                           and refuses a busy agent unless --force-busy
#   agent-chat watch <name...> [--interval 60] [--idle-alert MIN] [--respawn] [--report-to <name>]
#                                           blocking watchdog for an orchestrator's BACKGROUND shell: exits
#                                           with a report when an agent is dead, filter-tripped, errored,
#                                           usage-limited, has stuck input or idles too long (--respawn
#                                           replaces dead/filter-tripped ones itself); then re-arm it
#   agent-chat unregister [<name>]          leave the chat (default: self)
#   agent-chat web [port]                   local web viewer (default :8787): channels, live
#                                           messages, people with status + unread counts
#   agent-chat setup-codex [--title-id]     wire delivery/status hooks into OpenAI Codex CLI
#                                           (~/.codex/hooks.json — same hook contract); Codex
#                                           agents then join the same rooms as Claude agents.
#                                           --title-id also puts the thread id in Codex's terminal
#                                           title, which pins each agent to its pane exactly
#   agent-chat whereami                     what this session resolves to: cli, session id, terminal
#   agent-chat hook <EventName>             internal: called by Claude Code / Codex hooks (stdin = hook JSON)
#
# Identity: $CLAUDE_CODE_SESSION_ID (Claude), $CODEX_THREAD_ID (Codex) or
# $OPENCODE_SESSION_ID (OpenCode); --as <name> overrides.

BASE="${AGENT_CHAT_HOME:-$HOME/.claude/agent-chat}"
ROOMS="$BASE/rooms"
REG="$BASE/registry"
CUR="$BASE/cursors"
JQ="/usr/bin/jq"

mkdir -p "$ROOMS" "$REG" "$CUR"
# migrate pre-rooms layout: the old single chat.jsonl becomes #general
if [ -s "$BASE/chat.jsonl" ] && [ ! -e "$ROOMS/general.jsonl" ]; then
  mv "$BASE/chat.jsonl" "$ROOMS/general.jsonl"
fi
touch "$ROOMS/general.jsonl"

die() { echo "agent-chat: $*" >&2; exit 1; }
now() { date +"%Y-%m-%dT%H:%M:%S%z"; }

proj_room() { printf '%s' "$PWD" | sed 's/[^a-zA-Z0-9]/-/g'; }

valid_room() { printf '%s' "$1" | grep -Eq '^-?[A-Za-z0-9][A-Za-z0-9_-]{0,128}$'; }

# ---------- which CLI is running this command ----------

US=$'\037'   # field separator for internal records (never appears in titles/paths)

real_tty() { case "$1" in ''|'?'|'??'|'-') return 1;; esac; return 0; }

ancestry() { # this process's ancestors, nearest first: "pid<TAB>tty<TAB>command"
  local p="$PPID" pp tt cmd i=0
  while [ -n "$p" ] && [ "$p" -gt 1 ] 2>/dev/null && [ "$i" -lt 30 ]; do
    pp=""
    read -r pp tt cmd <<< "$(ps -o ppid=,tty=,command= -p "$p" 2>/dev/null)"
    [ -n "$pp" ] || break
    printf '%s\t%s\t%s\n' "$p" "$tt" "$cmd"
    p="$pp"; i=$((i + 1))
  done
}

# command line -> claude|codex|opencode, judged by the PROGRAM it runs (never by
# its arguments: a tool shell's command line contains the agent's whole command,
# message text included). rc 1 if it is none of them.
cli_of_cmd() {
  local a b rest
  read -r a b rest <<< "$1"
  a="${a#-}"
  case "${a##*/}" in node|nodejs|bun) a="$b";; esac
  case "${a##*/}" in
    claude|claude.js)     echo claude;;
    codex|codex.js)       echo codex;;
    opencode|opencode.js) echo opencode;;
    *) case "$a" in *claude-code*|*@anthropic-ai*) echo claude;; *) return 1;; esac;;
  esac
}

# self_identity -> "cli session-id" of the CLI running this command (rc 1: none).
# Each CLI exports its own id into its tool commands. More than one can be set
# when a CLI was started from inside another one's shell, or by a tmux server /
# background daemon that inherited one — then the NEAREST CLI ancestor decides.
self_identity() {
  local c="${CLAUDE_CODE_SESSION_ID:-}" x="${CODEX_THREAD_ID:-}" o="${OPENCODE_SESSION_ID:-}" n=0 cli="" _ cmd
  [ -n "$c" ] && n=$((n + 1)); [ -n "$x" ] && n=$((n + 1)); [ -n "$o" ] && n=$((n + 1))
  if [ "$n" -gt 1 ]; then
    cli=$(ancestry | while IFS=$'\t' read -r _ _ cmd; do cli_of_cmd "$cmd" && break; done)
    [ -n "$cli" ] || return 1   # conflicting inherited identities: never choose by variable order
  fi
  case "$cli" in
    claude)   [ -n "$c" ] && { echo "claude $c"; return 0; };;
    codex)    [ -n "$x" ] && { echo "codex $x"; return 0; };;
    opencode) [ -n "$o" ] && { echo "opencode $o"; return 0; };;
  esac
  [ "$n" -le 1 ] || return 1
  if   [ -n "$c" ]; then echo "claude $c"
  elif [ -n "$x" ]; then echo "codex $x"
  elif [ -n "$o" ]; then echo "opencode $o"
  else return 1; fi
}

# ---------- identity ----------

resolve_name() { # [session_id] -> registered name, rc=1 if not registered
  local sid="${1:-}"
  [ -n "$AS_NAME" ] && { echo "$AS_NAME"; return 0; }
  if [ -z "$sid" ]; then sid=$(self_identity) || return 1; sid="${sid#* }"; fi
  [ -z "$sid" ] && return 1
  local files=("$REG"/*.json)
  [ -e "${files[0]}" ] || return 1
  local name
  name=$($JQ -r --arg sid "$sid" 'select(.session_id == $sid) | .name' "${files[@]}" 2>/dev/null | head -n1)
  [ -n "$name" ] || return 1
  echo "$name"
}

require_name() {
  local name
  name=$(resolve_name) || die "this session is not registered. Run: agent-chat register <short-name>"
  echo "$name"
}

my_rooms() { $JQ -r '.rooms[]' "$REG/$1.json" 2>/dev/null; }
home_room() { $JQ -r '.home_room' "$REG/$1.json" 2>/dev/null; }

# ---------- core ----------

append_msg() { # room from to msg
  local line
  line=$($JQ -cn --arg ts "$(now)" --arg from "$2" --arg to "$3" --arg msg "$4" \
    '{ts:$ts,from:$from,to:$to,msg:$msg}') || die "failed to encode message"
  touch "$ROOMS/$1.jsonl"
  printf '%s\n' "$line" >> "$ROOMS/$1.jsonl"
}

FMT_ADDRESSED='select(.from != $me and (.to == "*" or .to == $me))
  | "[#\($room)] [\(.ts | sub("T"; " ") | .[0:16])] \(.from)\(if .to != "*" then " → you" else "" end): \(.msg)"'
FMT_PLAIN='"[\(.ts | sub("T"; " ") | .[0:16])] \(.from)\(if .to != "*" then " → \(.to)" else "" end): \(.msg)"'

# deliver <name>: print unread addressed to <name> across all joined rooms; advance cursors
deliver() {
  local name="$1" room f total cursor curfile chunk out=""
  while IFS= read -r room; do
    [ -n "$room" ] || continue
    f="$ROOMS/$room.jsonl"; [ -e "$f" ] || continue
    total=$(wc -l < "$f" | tr -d ' ')
    curfile="$CUR/$name@$room"
    cursor=$(cat "$curfile" 2>/dev/null || echo 0)
    case "$cursor" in (*[!0-9]*|'') cursor=0;; esac
    [ "$total" -le "$cursor" ] && continue
    chunk=$(tail -n +"$((cursor + 1))" "$f" | $JQ -r --arg me "$name" --arg room "$room" "$FMT_ADDRESSED")
    # $DELIVER_PENDING defers the cursor moves to commit_delivery, for callers
    # that hand the text to something that can fail (oc_push)
    if [ -n "${DELIVER_PENDING:-}" ]; then printf '%s\t%s\n' "$curfile" "$total" >> "$DELIVER_PENDING"
    else echo "$total" > "$curfile"; fi
    [ -n "$chunk" ] && out="${out}${chunk}"$'\n'
  done <<< "$(my_rooms "$name")"
  printf '%s' "$out"
}

commit_delivery() { # <pending-file> — apply the cursor moves a deferred deliver recorded
  local cf total
  while IFS=$'\t' read -r cf total; do
    [ -n "$cf" ] && echo "$total" > "$cf"
  done < "$1"
  rm -f "$1"
}

mail_payload() { # name text — the block an agent is shown when mail reaches it
  # (kept short: registered agents know the skill, and Claude Code wraps inbox
  #  deliveries in its own paragraph about peer messages anyway)
  printf '%s' "📨 agent-chat ($1):
$2"
}

set_cursor_eof() { # name room
  local f="$ROOMS/$2.jsonl"
  if [ -e "$f" ]; then wc -l < "$f" | tr -d ' ' > "$CUR/$1@$2"; else echo 0 > "$CUR/$1@$2"; fi
}

# ---------- commands ----------

cmd_register() {
  local name="$1"
  [ -n "$name" ] || die "usage: agent-chat register <name>"
  printf '%s' "$name" | grep -Eq '^[a-z0-9][a-z0-9_-]{0,31}$' \
    || die "name must be short lowercase [a-z0-9_-], e.g. 'summarizer'"
  # identity: Claude Code exports CLAUDE_CODE_SESSION_ID, Codex exports
  # CODEX_THREAD_ID (same UUID as its rollout file and `codex resume`),
  # OpenCode exports OPENCODE_SESSION_ID (ses_…, what `opencode -s` takes)
  local sid cli proom rooms_json
  if sid=$(self_identity); then cli="${sid%% *}"; sid="${sid#* }"
  else cli="unknown"; sid="manual-$$"; fi
  proom=$(proj_room)
  # drop stale entries binding this same session to a different name
  local f oldname
  for f in "$REG"/*.json; do
    [ -e "$f" ] || break
    oldname=$($JQ -r --arg sid "$sid" 'select(.session_id == $sid) | .name' "$f")
    if [ -n "$oldname" ] && [ "$oldname" != "$name" ]; then rm -f "$f" "$CUR/$oldname"@*; fi
  done
  local tb ta tsrc delivery="" inbox=""
  [ "$cli" = claude ] && inbox="${CLAUDE_CODE_MESSAGING_SOCKET:-}"
  read -r tb ta tsrc <<< "$(detect_term "$cli" "$sid" "$name")"
  # OpenCode running under its background service: mail is pushed into the
  # session through the server API (no hooks to pull it, no typing needed)
  if [ "$cli" = opencode ] && oc_service_run && oc_knows_session "$sid"; then delivery="api"; fi
  # OpenCode's TUI hands its own environment to the session it shows; a session
  # nobody opened in a TUI still has the service's, which names an unrelated
  # terminal — only keep it if an opencode really runs there
  if [ "$cli" = opencode ] && [ "$tsrc" = env ] && ! tty_has_cli "$(agent_tty "$tb" "$ta")" opencode; then
    tb="none"; ta="-"; tsrc="none"
  fi
  if [ -e "$REG/$name.json" ]; then
    # existing identity: silent rebind (new session/window/cwd), keep rooms + cursors
    rooms_json=$($JQ -c --arg hr "$proom" '(.rooms + [$hr]) | unique' "$REG/$name.json")
    $JQ -n --arg name "$name" --arg sid "$sid" --arg tb "$tb" --arg ta "$ta" --arg tsrc "$tsrc" --arg cli "$cli" \
          --arg dl "$delivery" --arg ib "$inbox" --arg cwd "$PWD" --arg ts "$(now)" --arg hr "$proom" --argjson rooms "$rooms_json" \
          '{name:$name, session_id:$sid, cli:$cli, term_backend:$tb, term_addr:$ta, term_src:$tsrc, cwd:$cwd, home_room:$hr, rooms:$rooms, registered_at:$ts}
           + (if $dl != "" then {delivery:$dl} else {} end) + (if $ib != "" then {inbox:$ib} else {} end)' \
          > "$REG/$name.json.tmp.$$" && mv "$REG/$name.json.tmp.$$" "$REG/$name.json"
    local r
    while IFS= read -r r; do
      [ -n "$r" ] && [ ! -f "$CUR/$name@$r" ] && set_cursor_eof "$name" "$r"
    done <<< "$(my_rooms "$name")"
    echo "Rebound '$name' to this session (silent — no join announcement, cursors kept)."
  else
    $JQ -n --arg name "$name" --arg sid "$sid" --arg tb "$tb" --arg ta "$ta" --arg tsrc "$tsrc" --arg cli "$cli" \
          --arg dl "$delivery" --arg ib "$inbox" --arg cwd "$PWD" --arg ts "$(now)" --arg hr "$proom" \
          '{name:$name, session_id:$sid, cli:$cli, term_backend:$tb, term_addr:$ta, term_src:$tsrc, cwd:$cwd, home_room:$hr, rooms:([$hr,"general"] | unique), registered_at:$ts}
           + (if $dl != "" then {delivery:$dl} else {} end) + (if $ib != "" then {inbox:$ib} else {} end)' \
          > "$REG/$name.json"
    append_msg "$proom" "system" "*" "$name joined (cwd: $PWD)"
    set_cursor_eof "$name" "$proom"
    set_cursor_eof "$name" "general"
    echo "Registered as '$name' (project room: #$proom, also in #general)."
  fi
  case "$cli" in
    codex|claude) [ "$tb" = none ] || set_term "$name" "$tb" "$ta" "$tsrc" "$sid" || return 1;;
  esac
  case "$tb" in
    none)
      if [ "$cli" = codex ]; then
        echo "Registered for mail, but no unique current Codex thread title identifies this pane. Run 'agent-chat setup-codex --title-id', then restart this TUI and register again. Repeating registration alone cannot prove the current thread; terminal control is disabled until it can be identified." >&2
      elif [ "$delivery" = api ]; then
        echo "Mail delivery: OpenCode server API (no iTerm/tmux terminal found, so peers can't watch or drive this session — messages and wake-ups still arrive)."
      else
        echo "note: no iTerm/tmux terminal found for this session — chat works, but peers can't wake (nudge), watch or drive it."
      fi;;
    *) echo "Terminal: $tb $ta (found via $tsrc)$([ "$delivery" = api ] && echo '; mail delivery: OpenCode server API')";;
  esac
  [ "$cli" = opencode ] && [ "$delivery" != api ] && \
    echo "note: this OpenCode session isn't run by the background service, so mail can't be pushed into it — peers wake you by typing a nudge; run 'agent-chat read' to fetch messages."
  echo "Agents currently registered:"
  cmd_who
}

cmd_unregister() {
  local name="${1:-}"
  [ -n "$name" ] || { name=$(require_name) || exit 1; }
  local hr; hr=$(home_room "$name")
  rm -f "$REG/$name.json" "$CUR/$name"@*
  [ -n "$hr" ] && append_msg "$hr" "system" "*" "$name left the chat"
  echo "Unregistered '$name'."
}

cmd_send() {
  local room="" to="*" nudge=0 quiet=0 msg=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --room) room="$2"; shift 2;;
      --to) to="$2"; shift 2;;
      --nudge) nudge=1; shift;;
      --quiet) quiet=1; shift;;
      *) [ -n "$msg" ] && die "one message per send (quote it)"; msg="$1"; shift;;
    esac
  done
  [ -n "$msg" ] || die 'usage: agent-chat send "<message>" [--room <room>] [--to <name>] [--nudge|--quiet]'
  local from
  from=$(require_name) || exit 1
  if [ -z "$room" ]; then
    if [ "$to" != "*" ]; then
      # DM routing: prefer a room BOTH agents are in, so working conversations
      # stay on the project channel instead of leaking into #general —
      # sender's home room first, then any other shared room, then #general
      # (the guaranteed common room) as the cross-project fallback.
      room="general"
      if [ -e "$REG/$to.json" ]; then
        local myhome shared
        myhome=$(home_room "$from")
        if $JQ -e --arg r "$myhome" '.rooms | index($r)' "$REG/$to.json" >/dev/null 2>&1; then
          room="$myhome"
        else
          shared=$(comm -12 <(my_rooms "$from" | sort) <($JQ -r '.rooms[]' "$REG/$to.json" | sort) \
                   | grep -v '^general$' | head -n1)
          [ -n "$shared" ] && room="$shared"
        fi
      fi
    else
      room=$(home_room "$from")
    fi
  fi
  valid_room "$room" || die "invalid room name '$room'"
  if [ "$to" != "*" ] && [ ! -e "$REG/$to.json" ]; then
    echo "warning: no agent named '$to' is registered (sending anyway)" >&2
  fi
  # sending to a room auto-joins it (so replies come back to you)
  if ! my_rooms "$from" | grep -qxF -- "$room"; then
    $JQ --arg r "$room" '.rooms = ((.rooms + [$r]) | unique)' "$REG/$from.json" > "$REG/$from.json.tmp" \
      && mv "$REG/$from.json.tmp" "$REG/$from.json"
    set_cursor_eof "$from" "$room"
    echo "(auto-joined #$room)"
  fi
  append_msg "$room" "$from" "$to" "$msg"
  echo "sent to #$room."
  # DMs nudge the recipient by default: hooks deliver only when the recipient
  # is ACTIVE, so an idle agent would otherwise never see the message
  # (--quiet opts out for pure FYIs). Room posts stay passive unless --nudge.
  if [ "$to" != "*" ] && [ "$quiet" = 0 ]; then nudge=1; fi
  # everyone registered, in one pass: name<US>delivery<US>is-a-member-of-this-room
  local name dl member st state src rc
  while IFS="$US" read -r name dl member <&3; do
    [ -n "$name" ] || continue
    [ "$name" = "$from" ] && continue
    [ "$to" != "*" ] && [ "$name" != "$to" ] && continue
    if [ "$member" != true ]; then
      # not in this room: a broadcast isn't for it; an explicit --room DM to a
      # non-member can still wake it (it'll read the room when it joins)
      { [ "$to" = "*" ] || [ "$nudge" = 0 ]; } && continue
    fi
    # push-delivered agents (OpenCode) have no hooks to pull mail with, so every
    # message for them — passive room posts too — is handed to their session now
    if [ "$dl" = api ]; then
      st=$(agent_state "$name"); state="${st%%$'\t'*}"; src="${st#*$'\t'}"
      case "$state" in
        dead|offline)
          [ "$nudge" = 1 ] && echo "  → $name is $state ($src) — message stored; it'll be delivered when that session is open again"
          continue;;
      esac
      oc_push "$name" "$nudge"; rc=$?
      case "$rc" in
        0) if [ "$nudge" = 1 ]; then
             case "$state" in
               busy)    echo "  → $name is busy — handed to its session, it'll see it at its next step";;
               waiting) echo "  → $name is blocked on a prompt/dialog — queued in its session, it'll see it when it resumes. Inspect: agent-chat screen $name";;
               *)       echo "  → $name was idle — delivered and woken";;
             esac
           fi
           continue;;
        1) [ "$nudge" = 1 ] && echo "  → $name has nothing unread from this (is it a member of #$room?)"
           continue;;
      esac
      [ "$nudge" = 1 ] && echo "  → $name: OpenCode server didn't accept the message — falling back to a terminal nudge" >&2
    fi
    [ "$nudge" = 1 ] || continue
    # state-aware delivery: only wake an agent that won't otherwise see it
    st=$(agent_state "$name"); state="${st%%$'\t'*}"; src="${st#*$'\t'}"
    case "$state" in
      busy)
        echo "  → $name is busy — hooks will deliver at its next turn boundary (not nudging)";;
      waiting)
        echo "  → $name is blocked on a prompt/dialog — NOT typing (would hit a button). It'll see the message when it resumes. Inspect: agent-chat screen $name";;
      idle)
        nudge_request "$name" "$from";;
      dead|offline)
        echo "  → $name is $state ($src) — message stored; it'll be delivered when that session restarts and re-registers";;
      unlocated)
        echo "  → $name: $src — NOT typing (no terminal to type into). Message stored; it sees it at its next turn boundary. To make it reachable, have it run: agent-chat register $name";;
      *)
        # unknown: nudge anyway (best-effort), typing is harmless at an idle prompt
        echo "  → $name state unknown ($src) — nudging best-effort"
        nudge_request "$name" "$from";;
    esac
  done 3<<< "$($JQ -r --arg r "$room" \
    '[.name, (.delivery // ""), (((.rooms // []) | index($r)) != null)] | map(tostring) | join("\u001f")' \
    "$REG"/*.json 2>/dev/null)"
}

cmd_read() {
  local name out
  name=$(require_name) || exit 1
  out=$(deliver "$name")
  if [ -n "$out" ]; then printf '%s\n' "$out"; else echo "No new messages."; fi
}

cmd_log() {
  local n=20 room=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --room) room="$2"; shift 2;;
      *) n="$1"; shift;;
    esac
  done
  if [ -z "$room" ]; then
    local name; name=$(resolve_name) || die "not registered — specify --room <room>"
    room=$(home_room "$name")
  fi
  [ -e "$ROOMS/$room.jsonl" ] || die "no room '#$room'"
  tail -n "$n" "$ROOMS/$room.jsonl" | $JQ -r "$FMT_PLAIN"
}

cmd_peek() {
  local room="${1:-}" n="${2:-20}"
  [ -n "$room" ] || die "usage: agent-chat peek <room> [N]"
  [ -e "$ROOMS/$room.jsonl" ] || die "no room '#$room' (agent-chat rooms to list)"
  tail -n "$n" "$ROOMS/$room.jsonl" | $JQ -r "$FMT_PLAIN"
}

cmd_rooms() {
  local name="" f room count last mark
  name=$(resolve_name) || true
  for f in "$ROOMS"/*.jsonl; do
    [ -e "$f" ] || break
    room=$(basename "$f" .jsonl)
    count=$(wc -l < "$f" | tr -d ' ')
    last=$(tail -n 1 "$f" 2>/dev/null | $JQ -r '.ts | sub("T"; " ") | .[0:16]' 2>/dev/null)
    mark=" "
    if [ -n "$name" ] && my_rooms "$name" | grep -qxF -- "$room"; then mark="*"; fi
    printf '%s #%s\t%s msgs\tlast: %s\n' "$mark" "$room" "$count" "${last:-—}"
  done
}

cmd_join() {
  local room="${1:-}" name
  [ -n "$room" ] || die "usage: agent-chat join <room>"
  valid_room "$room" || die "invalid room name '$room'"
  name=$(require_name) || exit 1
  my_rooms "$name" | grep -qxF -- "$room" && { echo "already in #$room"; return; }
  $JQ --arg r "$room" '.rooms = ((.rooms + [$r]) | unique)' "$REG/$name.json" > "$REG/$name.json.tmp" \
    && mv "$REG/$name.json.tmp" "$REG/$name.json"
  set_cursor_eof "$name" "$room"
  echo "Joined #$room (you'll receive messages posted from now on; agent-chat peek $room for history)."
}

cmd_leave() {
  local room="${1:-}" name
  [ -n "$room" ] || die "usage: agent-chat leave <room>"
  name=$(require_name) || exit 1
  [ "$room" = "general" ] && die "#general membership is fixed (DM delivery depends on it)"
  [ "$room" = "$(home_room "$name")" ] && die "cannot leave your project room"
  $JQ --arg r "$room" '.rooms = (.rooms - [$r])' "$REG/$name.json" > "$REG/$name.json.tmp" \
    && mv "$REG/$name.json.tmp" "$REG/$name.json"
  rm -f "$CUR/$name@$room"
  echo "Left #$room."
}

cmd_who() {
  local f found=0
  for f in "$REG"/*.json; do
    [ -e "$f" ] || break
    found=1
    $JQ -r '"  \(.name)\(if .cli and .cli != "claude" then " [" + .cli + "]" else "" end)\thome: #\(.home_room)\trooms: \(.rooms | map("#" + .) | join(", "))\tcwd: \(.cwd)"' "$f"
  done
  [ "$found" = 1 ] || echo "  (nobody registered)"
}

# ---------- finding an agent's terminal ----------
#
# The terminal is NOT simply $ITERM_SESSION_ID / $TMUX_PANE: those describe the
# process that exported them, and newer CLIs run tool commands in a shared
# background server (Codex's app-server daemon, OpenCode's service) whose
# environment belongs to whichever terminal happened to start it first. So:
#   1. Codex (regardless of ancestry)    -> unique current thread-id title
#   2. nearest tty ancestor              -> Claude Code's pane
#   3. otherwise the environment         (OpenCode's TUI forwards its own env
#      to the server for the session it shows, so there it IS the TUI's)

_term_list_raw() { # rc 1 when iTerm runs but its sessions couldn't be listed
  local rc=0
  if command -v tmux >/dev/null 2>&1; then
    tmux list-panes -a -F "tmux${US}#{pane_id}${US}#{pane_tty}${US}#{pane_title}" 2>/dev/null
  fi
  # (check it's running first: `tell application "iTerm2"` would LAUNCH iTerm on
  #  a tmux-only box. Not pgrep — on macOS it hides its own ancestors, and
  #  iTerm is the ancestor of every shell it hosts.)
  if command -v osascript >/dev/null 2>&1 && ps -axo comm= 2>/dev/null | grep -q '/iTerm2$'; then
    osascript <<'APPLESCRIPT' 2>/dev/null
set us to (ASCII character 31)
set out to ""
tell application "iTerm2"
  repeat with w in windows
    repeat with t in tabs of w
      repeat with s in sessions of t
        set out to out & "iterm" & us & (id of s as text) & us & (tty of s) & us & (name of s) & linefeed
      end repeat
    end repeat
  end repeat
end tell
return out
APPLESCRIPT
    [ $? = 0 ] || rc=1
  fi
  return $rc
}

# every reachable terminal, one per line: backend<US>addr<US>tty<US>title
# (tmux panes first, so a pane wins over the iTerm session tmux runs in).
# `warm_terms` snapshots it once for commands that resolve many agents.
term_list() {
  if [ -n "${_TERM_LIST+x}" ]; then printf '%s\n' "$_TERM_LIST"; else _term_list_raw; fi
}
# A failed AppleScript call (iTerm busy, an AppleEvent timeout) must not become
# an EMPTY snapshot: that reads as "every pane is closed" and marks all agents
# offline at once. Retry; if it still fails, drop the snapshot (lookups go
# live) and return 1 so callers that act on it can stand down.
warm_terms() {
  local i out
  for i in 1 2 3; do
    if out=$(_term_list_raw); then
      _TERM_LIST="$out"; _CODEX_CANDS=$(_codex_cands_raw); return 0
    fi
    sleep 1
  done
  unset _TERM_LIST _CODEX_CANDS
  return 1
}

term_by_tty() { # /dev/ttyX -> "backend addr"
  local b a t _
  while IFS="$US" read -r b a t _; do
    [ -n "$t" ] && [ "$t" = "$1" ] && { printf '%s %s' "$b" "$a"; return 0; }
  done <<< "$(term_list)"
  return 1
}

oc_service_run() { # is this command run by OpenCode's background service (not a standalone TUI)?
  # the nearest of the two decides: the service process, or something on a tty.
  # (the service itself may sit under a TUI's tty — a TUI that found no service
  #  running starts one as its own child — so "any tty ancestor" isn't the test)
  local _ t cmd
  while IFS=$'\t' read -r _ t cmd; do
    case "$cmd" in *opencode*" serve"*) return 0;; esac
    real_tty "$t" && return 1
  done <<< "$(ancestry)"
  return 1
}

lstart_epoch() { # ps lstart in the C locale ("Mon Oct 12 21:05:52 2026") -> unix seconds
  LC_ALL=C date -j -f '%a %b %d %T %Y' "$1" +%s 2>/dev/null || LC_ALL=C date -d "$1" +%s 2>/dev/null
}

# every terminal whose tty hosts a Codex TUI, one per line:
# backend<US>addr<US>title<US>process-start(epoch)<US>command
codex_cands() {
  if [ -n "${_CODEX_CANDS+x}" ]; then printf '%s\n' "$_CODEX_CANDS"; else _codex_cands_raw; fi
}
_codex_cands_raw() {
  local list procs b a t title tt d1 d2 d3 d4 d5 cmd
  list=$(term_list); [ -n "$list" ] || return 0
  procs=$(LC_ALL=C ps -axo tty=,lstart=,command= 2>/dev/null | grep -i codex)
  [ -n "$procs" ] || return 0
  while IFS="$US" read -r b a t title; do
    [ -n "$t" ] || continue
    while read -r tt d1 d2 d3 d4 d5 cmd; do
      [ "/dev/$tt" = "$t" ] || continue
      [ "$(cli_of_cmd "$cmd")" = codex ] || continue
      codex_tui_cmd "$cmd" || continue
      printf '%s\n' "${b}${US}${a}${US}${title}${US}$(lstart_epoch "$d1 $d2 $d3 $d4 $d5")${US}${cmd}"
    done <<< "$procs"
  done <<< "$list"
}

# A title is current evidence. Launch argv, old screen text, spawn hints and
# process start times cannot distinguish a TUI that has since switched threads.
thread_ids_in_title() {
  printf '%s' "$1" | grep -oE '[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[0-9a-f]{4}(-[0-9a-f]{1,12})?' | sort -u
}

title_matches_thread() { # title sid — exactly one unambiguous UUIDv7 prefix
  local shown
  shown=$(thread_ids_in_title "$1")
  [ -n "$shown" ] && [ "$(printf '%s\n' "$shown" | wc -l | tr -d ' ')" = 1 ] || return 1
  case "$2" in "$shown"*) return 0;; esac
  return 1
}

codex_tui_cmd() {
  [ "$(cli_of_cmd "$1")" = codex ] || return 1
  case " $1 " in
    *" app-server "*|*" exec-server "*|*" exec "*|*" mcp-server "*|*" remote-control "*) return 1;;
  esac
}

# codex_locate sid [unused-name] [unused-live] -> backend addr title.
# Duplicate wrappers on one tty count once; two panes showing the thread are
# ambiguous. Even a cached title binding must pass this check on every use.
codex_locate() {
  local tid="$1" b a title st cmd hits="" count
  [ "${#tid}" = 36 ] || return 1
  while IFS="$US" read -r b a title st cmd; do
    [ -n "$b" ] || continue
    title_matches_thread "$title" "$tid" || continue
    hits="${hits}${b} ${a}"$'\n'
  done <<< "$(codex_cands)"
  hits=$(printf '%s' "$hits" | sed '/^$/d' | sort -u)
  [ -n "$hits" ] || return 1
  count=$(printf '%s\n' "$hits" | wc -l | tr -d ' ')
  [ "$count" = 1 ] || return 1
  printf '%s title\n' "$hits"
}

# detect_term <cli> <session-id> <name> -> "backend addr src" for THIS session
# ("none - <why>" when there is no usable terminal). src records how it was
# found; Codex always needs a unique current thread-id title.
detect_term() {
  local cli="$1" sid="$2" name="$3" tt="" _ t loc
  if [ "$cli" = codex ]; then
    codex_locate "$sid" || echo "none - unlocated"
    return
  fi
  while IFS=$'\t' read -r _ t _; do
    real_tty "$t" && { tt="$t"; break; }
  done <<< "$(ancestry)"
  if [ -n "$tt" ] && loc=$(term_by_tty "/dev/$tt"); then echo "$loc ancestry"; return; fi
  if [ -n "${TMUX:-}" ] && [ -n "${TMUX_PANE:-}" ]; then echo "tmux ${TMUX_PANE} env"
  elif [ -n "${ITERM_SESSION_ID:-}" ]; then echo "iterm ${ITERM_SESSION_ID#*:} env"
  else echo "none - none"; fi
}

# ---------- OpenCode server API ----------
#
# OpenCode (v2) runs sessions in a background service with an HTTP API, reached
# through `opencode api`. That gives agent-chat a first-class channel that the
# hook-based CLIs lack: a message can be put straight into a session's inbox —
# picked up at the next step if the session is working, at its next prompt if
# it is idle, or (resume) waking it right now. No hooks, no typing.

oc_api() { # <operation> [args...] — prints the response; rc 127 without an opencode binary
  local oc
  oc=$(command -v opencode 2>/dev/null) || oc="$HOME/.opencode/bin/opencode"
  [ -x "$oc" ] || return 127
  "$oc" api "$@" 2>/dev/null </dev/null
}

oc_knows_session() { # session-id — does the running service have this session?
  oc_api session.get --param "sessionID=$1" | $JQ -e '.data.id' >/dev/null 2>&1
}

oc_state() { # session-id -> busy | waiting | idle ; rc 1 if the server can't say
  local sid="$1" active
  active=$(oc_api session.active) || return 1
  printf '%s' "$active" | $JQ -e '.data' >/dev/null 2>&1 || return 1
  if oc_api session.permission.list --param "sessionID=$sid" | $JQ -e '.data | length > 0' >/dev/null 2>&1 \
     || oc_api session.form.list --param "sessionID=$sid" | $JQ -e '.data | length > 0' >/dev/null 2>&1; then
    echo waiting
  elif printf '%s' "$active" | $JQ -e --arg s "$sid" '.data | has($s)' >/dev/null 2>&1; then
    echo busy
  else
    echo idle
  fi
}

# oc_push <name> <wake:0|1> — hand <name> everything it hasn't read, through
# the OpenCode API. wake=1 also starts the session if it is idle (the API
# equivalent of a nudge); wake=0 only queues it for the session's next step or
# prompt (what a hook delivery is for the other CLIs).
# rc 0 delivered · 1 nothing unread · 2 the server refused (cursors untouched)
oc_push() {
  local name="$1" wake="$2" sid text pend body resume=false lock="$CUR/.push-$1.lock" i=0
  sid=$(reg_get "$name" session_id)
  # one push per recipient at a time, or two senders would both deliver the same backlog
  while ! mkdir "$lock" 2>/dev/null; do
    i=$((i + 1)); [ "$i" -gt 50 ] && { rmdir "$lock" 2>/dev/null; i=0; }
    sleep 0.1
  done
  pend=$(mktemp "${TMPDIR:-/tmp}/agent-chat.XXXXXX")
  text=$(DELIVER_PENDING="$pend" deliver "$name")
  if [ -z "$text" ]; then
    commit_delivery "$pend"; rmdir "$lock" 2>/dev/null; return 1
  fi
  [ "$wake" = 1 ] && resume=true
  body=$($JQ -cn --arg t "$(mail_payload "$name" "$text")" --argjson r "$resume" \
    '{text:$t, description:"agent-chat", delivery:"steer", resume:$r}')
  if oc_api session.synthetic --param "sessionID=$sid" -d "$body" | $JQ -e '.data.id' >/dev/null 2>&1; then
    commit_delivery "$pend"; rmdir "$lock" 2>/dev/null; return 0
  fi
  rm -f "$pend"; rmdir "$lock" 2>/dev/null; return 2
}

reg_get() { $JQ -r --arg k "$2" '.[$k] // empty' "$REG/$1.json" 2>/dev/null; } # name field

process_token() { # pid -> process birth timestamp; PID alone can be reused
  local started
  started=$(LC_ALL=C ps -o lstart= -p "$1" 2>/dev/null) || return 1
  [ -n "$started" ] || return 1
  lstart_epoch "$(printf '%s' "$started" | sed 's/^ *//;s/ *$//')"
}

same_process() { [ -n "$2" ] && [ "$(process_token "$1")" = "$2" ]; }

is_shell_pid() {
  local cmd
  cmd=$(ps -o comm= -p "$1" 2>/dev/null); cmd="${cmd##*/}"
  case "$cmd" in zsh|-zsh|bash|-bash|fish|-fish|sh|-sh) return 0;; esac
  return 1
}

# session_proof cli sid backend addr -> tty pid birth parent-pid parent-birth.
# Used by both respawn implementations. These checks always bypass snapshots:
# a fleet snapshot is useful for observation, never permission to send input.
session_proof() {
  local cli="$1" sid="$2" tb="$3" ta="$4" tty pids pid born parent pb stat
  local _TERM_LIST _CODEX_CANDS; unset _TERM_LIST _CODEX_CANDS
  warm_terms || return 1
  tty=$(agent_tty "$tb" "$ta"); [ -n "$tty" ] || return 1
  pids=$(agent_pids "$tty" "$cli")
  [ -n "$pids" ] && [ "$(printf '%s\n' "$pids" | wc -l | tr -d ' ')" = 1 ] || return 1
  pid="$pids"
  stat=$(ps -o stat= -p "$pid" 2>/dev/null)
  case "$stat" in *+*) ;; *) return 1;; esac  # background CLI is not the keyboard owner
  case "$cli" in
    codex)
      title_matches_thread "$(term_title "$tb" "$ta")" "$sid" || return 1
      local found
      found=$(codex_locate "$sid") || return 1
      [ "$found" = "$tb $ta title" ] || return 1;;
    claude)
      [ "$($JQ -r '.sessionId // empty' "$HOME/.claude/sessions/$pid.json" 2>/dev/null)" = "$sid" ] || return 1;;
    *) return 1;;
  esac
  born=$(process_token "$pid") || return 1
  parent=$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ')
  pb=$(process_token "$parent") || return 1
  printf '%s %s %s %s %s\n' "$tty" "$pid" "$born" "$parent" "$pb"
}

shell_proof() { # backend addr tty shell-pid shell-birth
  local _TERM_LIST _CODEX_CANDS; unset _TERM_LIST _CODEX_CANDS
  [ -n "$3" ] && [ "$(agent_tty "$1" "$2")" = "$3" ] || return 1
  same_process "$4" "$5" && is_shell_pid "$4" || return 1
  [ "$(ps -o tty= -p "$4" 2>/dev/null | tr -d ' ')" = "${3#/dev/}" ] || return 1
  tty_fg_shell "$3"
}

set_term() { # name backend addr src [expected-sid]
  local name="$1" proof="" tty="" pid="" born="" parent="" pb="" cli sid
  cli=$(reg_get "$name" cli); sid=$(reg_get "$name" session_id)
  [ -z "${5:-}" ] || [ "$sid" = "$5" ] || return 1
  if proof=$(session_proof "$cli" "$sid" "$2" "$3"); then
    read -r tty pid born parent pb <<< "$proof"
  elif [ "$cli" = codex ]; then
    return 1
  fi
  $JQ --arg tb "$2" --arg ta "$3" --arg src "$4" --arg sid "$sid" \
      --arg tty "$tty" --arg pid "$pid" --arg born "$born" --arg parent "$parent" --arg pb "$pb" --arg verified "${proof:+$sid}" \
    'select(.session_id == $sid) | .term_backend = $tb | .term_addr = $ta | .term_src = $src
     | .term_tty = $tty | .term_cli_pid = $pid | .term_cli_birth = $born
     | .term_shell_pid = $parent | .term_shell_birth = $pb | .term_verified_session = $verified' "$REG/$name.json" > "$REG/$name.json.tmp.$$" \
    && [ -s "$REG/$name.json.tmp.$$" ] && mv "$REG/$name.json.tmp.$$" "$REG/$name.json"
}

# A dead CLI can be recovered only in its previously verified, unchanged
# shell. Legacy records without a shell fingerprint cannot authorize recovery.
saved_shell_proof() {
  local name="$1" tb="$2" ta="$3" oldpid oldbirth
  [ "$(reg_get "$name" term_verified_session)" = "$(reg_get "$name" session_id)" ] || return 1
  oldpid=$(reg_get "$name" term_cli_pid); oldbirth=$(reg_get "$name" term_cli_birth)
  [ -n "$oldpid" ] && ! same_process "$oldpid" "$oldbirth" || return 1
  shell_proof "$tb" "$ta" "$(reg_get "$name" term_tty)" \
    "$(reg_get "$name" term_shell_pid)" "$(reg_get "$name" term_shell_birth)"
}

# resolve_term name -> backend addr. 2 means unlocated, 3 means pane closed.
# Codex always needs a unique CURRENT title. Historical hints are never proof.
resolve_term() {
  local f="$REG/$1.json" tb ta cli sid loc src
  [ -e "$f" ] || return 1
  tb=$(reg_get "$1" term_backend); ta=$(reg_get "$1" term_addr)
  cli=$(reg_get "$1" cli); sid=$(reg_get "$1" session_id)
  if [ -z "$tb" ]; then
    ta=$(reg_get "$1" iterm_session_id); ta="${ta#*:}"
    [ -n "$ta" ] && tb=iterm
  fi
  if [ "$cli" = codex ]; then
    if loc=$(codex_locate "$sid"); then
      read -r tb ta src <<< "$loc"
      set_term "$1" "$tb" "$ta" "$src" "$sid" || return 2
      printf '%s %s' "$tb" "$ta"; return 0
    fi
    if saved_shell_proof "$1" "$tb" "$ta"; then printf '%s %s' "$tb" "$ta"; return 0; fi
    # Only a previously fingerprinted terminal that is now gone is OFFLINE.
    # Missing evidence says nothing about whether the thread itself is alive.
    if [ -n "$(reg_get "$1" term_tty)" ] && [ -z "$(agent_tty "$tb" "$ta")" ]; then return 3; fi
    return 2
  fi
  { [ -n "$tb" ] && [ "$tb" != none ]; } || return 1
  printf '%s %s' "$tb" "$ta"
}

title_shows_other_thread() {
  local shown
  while read -r shown; do
    [ -n "$shown" ] || continue
    case "$2" in "$shown"*) ;; *) return 0;; esac
  done <<< "$(thread_ids_in_title "$1")"
  return 1
}

# Pin the requested session across sleeps and multi-key sequences. Failure is
# final for this operation, even if the same agent name was rebound elsewhere.
control_proof() { # name backend addr expected-sid
  local cli term other
  local _TERM_LIST _CODEX_CANDS; unset _TERM_LIST _CODEX_CANDS
  [ "$(reg_get "$1" session_id)" = "$4" ] || return 1
  other=$(pane_taken_by_other "$1" "$2" "$3"); [ -z "$other" ] || return 1
  cli=$(reg_get "$1" cli)
  case "$cli" in
    codex|claude) session_proof "$cli" "$4" "$2" "$3" >/dev/null;;
    *) term=$(resolve_term "$1") && [ "$term" = "$2 $3" ] && tty_has_cli "$(agent_tty "$2" "$3")" "$cli";;
  esac
}

control_type() { # name backend addr sid text
  control_proof "$1" "$2" "$3" "$4" || { echo "agent-chat: terminal ownership changed or cannot be proved — no input sent" >&2; return 1; }
  term_type "$2" "$3" "$5"
}

control_key() { # name backend addr sid key
  control_proof "$1" "$2" "$3" "$4" || { echo "agent-chat: terminal ownership changed or cannot be proved — no key sent" >&2; return 1; }
  term_key "$2" "$3" "$5"
}

control_enter() {
  [ "$2" != tmux ] || sleep 1
  control_key "$1" "$2" "$3" "$4" enter
}

agent_term() { # name -> "backend addr" from the registry; dies when there is no usable terminal
  [ -e "$REG/$1.json" ] || die "no agent named '$1' is registered"
  local out rc
  out=$(resolve_term "$1"); rc=$?
  case "$rc" in
    0) printf '%s' "$out";;
    2) die "can't prove the current pane for '$1' (codex) — enable thread-id with 'agent-chat setup-codex --title-id', restart that TUI, and register again";;
    3) die "'$1' (codex) has a closed verified terminal";;
    *) die "'$1' has no terminal recorded (registered outside iTerm/tmux?)";;
  esac
}

iterm_write() { # uuid raw-bytes — write into the iTerm session verbatim, no auto-newline
  local result
  result=$(osascript - "$1" "$2" <<'APPLESCRIPT'
on run argv
  set targetId to item 1 of argv
  set payload to item 2 of argv
  tell application "iTerm2"
    repeat with w in windows
      repeat with t in tabs of w
        repeat with s in sessions of t
          if (id of s as text) is equal to targetId then
            tell s to write text payload newline NO
            return "ok"
          end if
        end repeat
      end repeat
    end repeat
  end tell
  return "session not found (window closed?)"
end run
APPLESCRIPT
) || return 1
  [ "$result" = ok ] || { echo "agent-chat: $result" >&2; return 1; }
  echo ok
}

# terminal I/O primitives — dispatch on backend ("iterm" uuid | "tmux" pane-id)
term_type() { # backend addr text — type WITHOUT submitting
  case "$1" in
    iterm) iterm_write "$2" "$3";;
    tmux)  tmux send-keys -t "$2" -l -- "$3" && echo ok;;
    *) die "unsupported terminal backend '$1'";;
  esac
}

term_enter() { # backend addr — a real Enter keypress (separate from the text: bracketed paste)
  case "$1" in
    iterm) iterm_write "$2" $'\r';;
    # the pause matters: tmux delivers the text and the Enter microseconds
    # apart, and Codex/Claude read that as one pasted burst — the Enter then
    # lands in the input box as a newline instead of submitting (0.4s still
    # missed sometimes with Claude Code 2.1.3xx; iTerm's two osascript calls
    # are naturally far enough apart)
    tmux)  sleep 1; tmux send-keys -t "$2" Enter && echo ok;;
    *) die "unsupported terminal backend '$1'";;
  esac
}

term_key() { # backend addr keyname
  local b="$1" a="$2" k="$3"
  case "$b" in
    iterm)
      local seq
      case "$k" in
        esc|escape)      seq=$'\033';;
        enter|return|cr) seq=$'\r';;
        ctrl-c) seq=$'\003';; ctrl-d) seq=$'\004';; ctrl-b) seq=$'\002';;
        ctrl-o) seq=$'\017';; ctrl-r) seq=$'\022';; ctrl-t) seq=$'\024';;
        ctrl-v) seq=$'\026';; ctrl-z) seq=$'\032';;
        tab) seq=$'\t';; shift-tab) seq=$'\033[Z';;
        up) seq=$'\033[A';; down) seq=$'\033[B';; right) seq=$'\033[C';; left) seq=$'\033[D';;
        space) seq=' ';; backspace) seq=$'\177';;
        *) die "unknown key '$k'";;
      esac
      iterm_write "$a" "$seq"
      ;;
    tmux)
      local tk
      case "$k" in
        esc|escape) tk="Escape";;
        enter|return|cr) tk="Enter";;
        ctrl-c) tk="C-c";; ctrl-d) tk="C-d";; ctrl-b) tk="C-b";;
        ctrl-o) tk="C-o";; ctrl-r) tk="C-r";; ctrl-t) tk="C-t";;
        ctrl-v) tk="C-v";; ctrl-z) tk="C-z";;
        tab) tk="Tab";; shift-tab) tk="BTab";;
        up) tk="Up";; down) tk="Down";; right) tk="Right";; left) tk="Left";;
        space) tk="Space";; backspace) tk="BSpace";;
        *) die "unknown key '$k'";;
      esac
      tmux send-keys -t "$a" "$tk" && echo ok
      ;;
    *) die "unsupported terminal backend '$b'";;
  esac
}

term_screen() { # backend addr — visible terminal contents
  case "$1" in
    iterm)
      osascript - "$2" <<'APPLESCRIPT'
on run argv
  set targetId to item 1 of argv
  tell application "iTerm2"
    repeat with w in windows
      repeat with t in tabs of w
        repeat with s in sessions of t
          if (id of s as text) is equal to targetId then return (contents of s)
        end repeat
      end repeat
    end repeat
  end tell
  error "agent-chat: session not found (window closed?)"
end run
APPLESCRIPT
      ;;
    tmux) tmux capture-pane -p -t "$2";;
    *) die "unsupported terminal backend '$1'";;
  esac
}

# ---------- liveness & status ----------
#
# Layered status, most-authoritative first:
#   1. terminal reachable? (iterm session / tmux pane exists)  — else OFFLINE
#   2. the agent's CLI (claude / codex / opencode) alive on its tty? — else DEAD
#   3. OpenCode only: its server says busy / waiting / idle outright
#   4. title glyph (the CLI's own render loop; ALWAYS fresh, can't go stale):
#        ⠂/⠐ animating = busy · ✳ static = idle-or-waiting
#   5. hook status file: adds the "waiting" sub-state the glyph can't express,
#      and is the fallback when the title is unreadable. TTL-guarded so a
#      crashed/escaped session's stale "busy" never wins over the live glyph.

STATUS="$BASE/status"
STATUS_TTL=180   # seconds; a hook stamp older than this is not trusted on its own

term_field() { # backend addr tty|title — answered from the terminal snapshot; rc 1 if none was taken
  [ -n "${_TERM_LIST+x}" ] || return 1
  local b a t title
  while IFS="$US" read -r b a t title; do
    if [ "$b" = "$1" ] && [ "$a" = "$2" ]; then
      if [ "$3" = tty ]; then printf '%s' "$t"; else printf '%s' "$title"; fi
      return 0
    fi
  done <<< "$_TERM_LIST"
  return 0   # snapshot taken and the terminal isn't in it: gone
}

term_title() { # backend addr -> current terminal title (carries the state glyph)
  term_field "$1" "$2" title && return
  case "$1" in
    tmux) tmux display -p -t "$2" '#{pane_title}' 2>/dev/null;;
    iterm)
      osascript - "$2" <<'APPLESCRIPT' 2>/dev/null
on run argv
  set targetId to item 1 of argv
  tell application "iTerm2"
    repeat with w in windows
      repeat with t in tabs of w
        repeat with s in sessions of t
          if (id of s as text) is equal to targetId then return (name of s)
        end repeat
      end repeat
    end repeat
  end tell
  return ""
end run
APPLESCRIPT
      ;;
  esac
}

glyph_state() { # title -> busy | idle | unknown  (from the leading status glyph)
  case "$1" in
    "⠂"*|"⠐"*) echo busy;;      # Claude Code TITLE_ANIMATION_FRAMES (<= 2.1.2xx)
    "◐"*|"◑"*|"◒"*|"◓"*)
               echo busy;;      # Claude Code's busy frames since ~2.1.29x
    "⠋"*|"⠙"*|"⠹"*|"⠸"*|"⠼"*|"⠴"*|"⠦"*|"⠧"*|"⠇"*|"⠏"*)
               echo busy;;      # Codex braille spinner (dots) while working
    "✳"*)      echo idle;;      # Claude Code static prefix: idle OR waiting
    *)         echo unknown;;   # no glyph: title disabled, or an idle Codex
                                # (plain title) — resolved via hook stamps
  esac
}

agent_tty() { # backend addr -> tty path, empty if terminal is gone
  term_field "$1" "$2" tty && return
  case "$1" in
    tmux)  tmux display -p -t "$2" '#{pane_tty}' 2>/dev/null;;
    iterm)
      osascript - "$2" <<'APPLESCRIPT' 2>/dev/null
on run argv
  set targetId to item 1 of argv
  tell application "iTerm2"
    repeat with w in windows
      repeat with t in tabs of w
        repeat with s in sessions of t
          if (id of s as text) is equal to targetId then return (tty of s)
        end repeat
      end repeat
    end repeat
  end tell
  return ""
end run
APPLESCRIPT
      ;;
  esac
}

stamp_status() { # name state — record a hook-observed state with a timestamp
  mkdir -p "$STATUS"
  printf '%s %s\n' "$2" "$(date +%s)" > "$STATUS/$1"
}

tty_has_cli() {
  local cmd found
  [ -n "$1" ] || return 1
  while read -r cmd; do
    found=$(cli_of_cmd "$cmd") || continue
    [ "$found" != codex ] || codex_tui_cmd "$cmd" || continue
    if [ "$2" = unknown ] || [ "$2" = any ] || [ "$found" = "$2" ]; then return 0; fi
  done <<< "$(ps -t "${1#/dev/}" -o command= 2>/dev/null)"
  return 1
}

# agent_state <name> -> prints "STATE\tSOURCE"
# STATE: busy | idle | waiting | dead | offline | unknown | unlocated
# (unlocated = alive or not, there is no terminal we could check or type into)
agent_state() {
  local name="$1" cli api=0 term rc tb="" ta="" tty g title hstate hepoch age st
  # one look at the terminals answers every question below (tty, title, Codex location)
  if [ -z "${_TERM_LIST+x}" ]; then
    local _TERM_LIST
    _TERM_LIST=$(_term_list_raw) || { printf 'unlocated\tterminal inventory unavailable\n'; return; }
  fi
  cli=$(reg_get "$name" cli); [ -n "$cli" ] || cli=claude
  [ "$(reg_get "$name" delivery)" = api ] && api=1
  term=$(resolve_term "$name"); rc=$?
  if [ "$rc" = 0 ]; then
    read -r tb ta <<< "$term"
    tty=$(agent_tty "$tb" "$ta")
    [ -n "$tty" ] || { printf 'offline\twindow/pane closed\n'; return; }
    if ! tty_has_cli "$tty" "$cli"; then
      case "$cli" in claude|codex|opencode) st="$cli";; *) st="agent CLI";; esac
      printf 'dead\tno %s process on tty (crashed/exited)\n' "$st"; return
    fi
  elif [ "$rc" = 2 ]; then
    printf 'unlocated\tcan%st tell which terminal its Codex TUI is in\n' "'"; return
  elif [ "$rc" = 3 ]; then
    printf 'offline\tverified terminal closed\n'; return
  elif [ "$api" = 0 ]; then
    printf 'unlocated\tno terminal on record (registered outside iTerm/tmux)\n'; return
  fi
  # OpenCode's server knows the session's state first-hand
  if [ "$api" = 1 ] && st=$(oc_state "$(reg_get "$name" session_id)"); then
    stamp_status "$name" "$st"   # no hooks stamp it: keep the web viewer's dot current
    printf '%s\topencode api\n' "$st"; return
  fi
  [ -n "$tb" ] || { printf 'unlocated\tno terminal on record and the OpenCode server is unreachable\n'; return; }
  title=$(term_title "$tb" "$ta"); g=$(glyph_state "$title")
  hstate=""; if [ -f "$STATUS/$name" ]; then read -r hstate hepoch < "$STATUS/$name"; fi
  age=999999; [ -n "${hepoch:-}" ] && age=$(( $(date +%s) - hepoch ))
  _combine_state "$g" "$hstate" "$age"
}

# _combine_state <glyph:busy|idle|unknown> <hookstate> <age-secs> -> "STATE\tSOURCE"
# Pure decision table (no I/O) so it is unit-testable. The glyph is the
# always-fresh primary for busy/idle; the hook file only ADDS the "waiting"
# sub-state (which looks like ✳ idle to the glyph) and serves as the fallback
# when the title is unreadable — TTL-guarded so a stale stamp never wins.
_combine_state() {
  local g="$1" hstate="$2" age="$3"
  case "$g" in
    busy) printf 'busy\tglyph\n';;
    idle)
      if [ "$hstate" = "waiting" ] && [ "$age" -le "$STATUS_TTL" ]; then
        printf 'waiting\thook(fresh)\n'      # glyph shows ✳ but a permission prompt is up
      else
        printf 'idle\tglyph\n'               # stale/absent/non-waiting hook → glyph wins
      fi
      ;;
    *) # no glyph (title disabled, or an idle Codex whose title is plain):
      # fall back to hook stamps. `idle` is trusted at ANY age — every
      # transition away from idle (prompt submit, tool use) re-stamps busy,
      # so an idle stamp only goes stale if the session died (caught by the
      # liveness layers above). busy/waiting stay TTL-guarded: an interrupted
      # or crashed turn leaves them behind with nothing to correct them.
      if [ "$hstate" = "idle" ]; then
        printf 'idle\thook (glyph-less title)\n'
      elif [ -n "$hstate" ] && [ "$age" -le "$STATUS_TTL" ]; then
        printf '%s\thook(fresh, glyph-less title)\n' "$hstate"
      else
        printf 'unknown\tno glyph, no fresh hook stamp\n'
      fi
      ;;
  esac
}

cmd_status() { # [name] — resolve one agent's live state (default: all)
  local name="${1:-}"
  if [ -n "$name" ]; then
    [ -e "$REG/$name.json" ] || die "no agent named '$name' is registered"
    local st; st=$(agent_state "$name")
    printf '%-16s %s\n' "$name" "$(printf '%s' "$st" | sed 's/\t/  (/;s/$/)/')"
    return
  fi
  local f n
  warm_terms
  for f in "$REG"/*.json; do
    [ -e "$f" ] || { echo "  (nobody registered)"; break; }
    n=$($JQ -r .name "$f")
    printf '%-16s %s\n' "$n" "$(agent_state "$n" | sed 's/\t/  (/;s/$/)/')"
  done
}

cmd_whereami() { # [--porcelain] — what THIS session resolves to (also used by the respawn skill)
  local sid cli tb="" ta="" tsrc="" name term
  if sid=$(self_identity); then cli="${sid%% *}"; sid="${sid#* }"; else cli="unknown"; sid="-"; fi
  name=$(resolve_name 2>/dev/null) || name=""
  if [ "$cli" = codex ] && [ -n "$name" ] && [ -z "$AS_NAME" ]; then
    if term=$(resolve_term "$name"); then
      read -r tb ta <<< "$term"; tsrc=$(reg_get "$name" term_src)
    else tb=none; ta=-; tsrc=unlocated; fi
  else
    read -r tb ta tsrc <<< "$(detect_term "$cli" "$sid" "")"
  fi
  if [ "${1:-}" = "--porcelain" ]; then printf '%s %s %s %s %s\n' "$cli" "$sid" "$tb" "$ta" "$tsrc"; return; fi
  printf 'cli:      %s\nsession:  %s\nname:     %s\nterminal: %s %s (found via %s)\n' \
    "$cli" "$sid" "${name:-(not registered)}" "$tb" "$ta" "$tsrc"
}

# ---------- Claude Code inbox socket ----------
#
# Claude Code (>= 2.1.224) gives every session an inbox: a Unix socket, exported
# to its hooks and Bash as $CLAUDE_CODE_MESSAGING_SOCKET (<dir>/<pid>.sock). A
# JSON line posted there is read between tool calls of a running turn, or
# STARTS a turn when the session is idle — no typing, so whatever a human has
# half-typed in the input box stays where it is. The catch: a session that
# bypasses permission prompts HOLDS such a message (an approval dialog per
# message) unless "crossSessionInbound": "accept" applies to it — so the inbox
# is only used where it is known to deliver, and typing stays the fallback.

cc_inbox() { # name -> the agent's live inbox socket; rc 1 if it has none we can use
  local reg dir term tb ta tty pid born parent pb proof
  reg=$(reg_get "$1" inbox)
  term=$(resolve_term "$1") || return 1
  read -r tb ta <<< "$term"
  proof=$(session_proof claude "$(reg_get "$1" session_id)" "$tb" "$ta") || return 1
  read -r tty pid born parent pb <<< "$proof"
  dir=$(dirname "${reg:-/tmp/cc-socks/x}")
  # the socket is named after its session's pid: only trust one whose claude
  # still runs on this agent's tty (a restart in the pane gets a new socket)
  [ -S "$dir/$pid.sock" ] && { echo "$dir/$pid.sock"; return 0; }
  return 1
}

cc_inbound_accepts() { # name — will its session deliver an outside message without a dialog?
  local mode cwd f
  mode=$(cat "$STATUS/$1.mode" 2>/dev/null)
  # prompting sessions deliver anything that doesn't claim to bypass; a bypassing
  # one (plan mode may count as bypassing) only with an explicit accept
  case "$mode" in default|acceptEdits|auto|dontAsk) return 0;; esac
  cwd=$(reg_get "$1" cwd)
  for f in "$cwd/.claude/settings.local.json" "$cwd/.claude/settings.json" "$HOME/.claude/settings.json"; do
    [ -f "$f" ] || continue
    case "$($JQ -r '.crossSessionInbound // empty' "$f" 2>/dev/null)" in
      accept) return 0;;
      hold|refuse) return 1;;
    esac
  done
  return 1
}

# cc_push <name> — hand <name> everything it hasn't read through its inbox socket.
# rc 0 delivered · 1 nothing unread · 2 no usable inbox / refused (cursors untouched)
cc_push() {
  local name="$1" sock text pend lock="$CUR/.push-$1.lock" i=0
  cc_inbound_accepts "$name" && sock=$(cc_inbox "$name") || return 2
  while ! mkdir "$lock" 2>/dev/null; do
    i=$((i + 1)); [ "$i" -gt 50 ] && { rmdir "$lock" 2>/dev/null; i=0; }
    sleep 0.1
  done
  pend=$(mktemp "${TMPDIR:-/tmp}/agent-chat.XXXXXX")
  text=$(DELIVER_PENDING="$pend" deliver "$name")
  if [ -z "$text" ]; then
    commit_delivery "$pend"; rmdir "$lock" 2>/dev/null; return 1
  fi
  if $JQ -cn --arg t "$(mail_payload "$name" "$text")" '{type:"user", message:{role:"user", content:$t}}' \
     | nc -U -w 2 "$sock" >/dev/null 2>&1; then
    commit_delivery "$pend"; rmdir "$lock" 2>/dev/null; return 0
  fi
  rm -f "$pend"; rmdir "$lock" 2>/dev/null; return 2
}

# ---------- nudge (wake an idle agent by typing into its prompt) ----------
#
# Typing into a pane someone is typing in garbles both: the human's half-written
# prompt gets the wake-up line glued on and submitted. So a nudge only types when
#   1. nobody is at THAT pane's keyboard: it isn't the focused pane of the
#      frontmost terminal, or no key was pressed for NUDGE_HANDS_OFF seconds
#      (work in other windows/apps doesn't count), and
#   2. its screen is still: two snapshots NUDGE_SETTLE seconds apart are equal.
# Text sitting unchanged in the input box does NOT block (a forgotten word, an
# autocomplete suggestion) — the nudge is typed after it.
# Otherwise the nudge is deferred to a background worker that retries until it
# lands, the agent reads its mail some other way (e.g. the human submits: the
# prompt hook delivers it), or NUDGE_GIVEUP passes. Nudges to one agent are
# combined: at most one per NUDGE_GAP seconds, naming every sender since.

NUDGE_DIR="$BASE/nudge"
NUDGE_GAP=30
NUDGE_HANDS_OFF=20
NUDGE_SETTLE=1.5
NUDGE_RETRY=5
NUDGE_GIVEUP=1800

has_unread() { [ -n "$(DELIVER_PENDING=/dev/null deliver "$1")" ]; } # name — without consuming

key_idle() { # seconds since the last keyboard/mouse input anywhere on this Mac
  ioreg -c IOHIDSystem 2>/dev/null | awk '/HIDIdleTime/ { print int($NF / 1000000000); exit }'
}

# pane_key_idle <backend> <addr> -> seconds since a key was pressed IN that pane;
# prints nothing when the pane doesn't have the keyboard (so nobody types there)
pane_key_idle() {
  case "$1" in
    iterm)
      local focused
      focused=$(osascript - "$2" <<'APPLESCRIPT' 2>/dev/null
on run argv
  tell application "iTerm2"
    if not frontmost then return "no"
    try
      if (id of current session of current tab of current window as text) is equal to (item 1 of argv) then return "yes"
    end try
  end tell
  return "no"
end run
APPLESCRIPT
)
      [ "$focused" = yes ] && key_idle;;
    tmux)
      local act cs
      act=$(tmux display -p -t "$2" '#{pane_active}#{window_active}#{session_attached}' 2>/dev/null)
      case "$act" in 11[1-9]*) ;; *) return 0;; esac
      cs=$(tmux display -p -t "$2" '#{session_name}')
      tmux list-clients -t "$cs" -F '#{client_activity}' 2>/dev/null \
        | sort -n | tail -n1 | awk -v now="$(date +%s)" 'NF { print now - $1 }';;
  esac
}

screen_tail() { term_screen "$1" "$2" 2>/dev/null | sed -e :a -e '/^[[:space:]]*$/{$d;N;ba' -e '}' | tail -n 12; }

# nudge_blocker <backend> <addr> -> why typing now would collide ("" = clear)
nudge_blocker() {
  local idle a b
  idle=$(pane_key_idle "$1" "$2")
  if [ -n "$idle" ] && [ "$idle" -lt "$NUDGE_HANDS_OFF" ]; then
    echo "someone is typing in its pane (focused, last key ${idle}s ago)"; return
  fi
  a=$(screen_tail "$1" "$2")
  printf '%s' "$a" | grep -q 'esc to interrupt' && { echo "it is working (spinner on screen)"; return; }
  sleep "$NUDGE_SETTLE"; b=$(screen_tail "$1" "$2")
  [ "$a" = "$b" ] || echo "its screen is changing (someone typing?)"
}

nudge_type() { # name backend addr text expected-sid
  local text
  text=$(printf '%s' "$4" | tr -d '"\\')
  control_type "$1" "$2" "$3" "$5" "$text" >/dev/null || return 1
  control_enter "$1" "$2" "$3" "$5" >/dev/null || return 1
  sleep 1.5
  if screen_tail "$2" "$3" | grep -E '^[❯›>] ' | tail -n1 | grep -qF -- "${text: -40}"; then
    control_enter "$1" "$2" "$3" "$5" >/dev/null || return 1
  fi
}

nudge_text() { # name — the wake-up line for everyone waiting on this agent
  local who
  who=$(sort -u "$NUDGE_DIR/$1.from" 2>/dev/null | paste -sd, - | sed 's/,/, /g')
  echo "[agent-chat] new message(s)${who:+ from $who} — run: agent-chat read"
}

nudge_last() { cat "$NUDGE_DIR/$1.last" 2>/dev/null || echo 0; }

nudge_worker_alive() { # name
  local pid; pid=$(cat "$NUDGE_DIR/$1.worker" 2>/dev/null) || return 1
  [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

nudge_now() { # name — one guarded attempt. rc 0 typed · 1 blocked (reason on stdout) · 2 no terminal
  local term tb ta why sid
  sid=$(reg_get "$1" session_id)
  term=$(resolve_term "$1") || return 2
  read -r tb ta <<< "$term"
  why=$(nudge_blocker "$tb" "$ta")
  [ -n "$why" ] && { echo "$why"; return 1; }
  nudge_type "$1" "$tb" "$ta" "$(nudge_text "$1")" "$sid" || return 2
  date +%s > "$NUDGE_DIR/$1.last"; rm -f "$NUDGE_DIR/$1.from"
}

# nudge_request <name> <from> — wake <name> about mail from <from>: right away
# when safe, else hand it to the background worker. Prints the outcome.
nudge_request() {
  local name="$1" wait why
  # a Claude Code agent whose inbox delivers needs no typing at all
  if [ "$(reg_get "$name" cli)" = claude ]; then
    cc_push "$name"
    case $? in
      0) echo "  → $name was idle — delivered to its inbox (woken without typing)"; return;;
      1) echo "  → $name has nothing unread from this"; return;;
    esac
  fi
  mkdir -p "$NUDGE_DIR"
  printf '%s\n' "$2" >> "$NUDGE_DIR/$name.from"
  if nudge_worker_alive "$name"; then
    echo "  → $name was idle — a nudge is already pending; this message joins it"; return
  fi
  wait=$(( NUDGE_GAP - ($(date +%s) - $(nudge_last "$name")) ))
  if [ "$wait" -le 0 ]; then
    why=$(nudge_now "$name") && { echo "  → $name was idle — nudged"; return; }
    [ -z "$why" ] && { echo "  → $name: couldn't type into its terminal"; return; }
    echo "  → $name was idle, but $why — nudge deferred (retried in the background; dropped if it reads the mail first)"
  else
    echo "  → $name was idle — nudged $(( NUDGE_GAP - wait ))s ago already; the next nudge (in ≤${wait}s) covers this one"
  fi
  ( nohup "$0" _nudge-worker "$name" >/dev/null 2>&1 </dev/null & )
}

cmd_nudge_worker() { # name — background: land one combined nudge, then exit
  local name="$1" start st state lock="$NUDGE_DIR/$1.lock"
  mkdir -p "$NUDGE_DIR"
  if ! mkdir "$lock" 2>/dev/null; then
    nudge_worker_alive "$name" && exit 0  # another worker has it
    rm -f "$NUDGE_DIR/$name.worker"       # a dead one's leftovers: take over
  fi
  # (expanded now: the locals are gone by the time EXIT fires)
  trap "rm -f '$NUDGE_DIR/$name.worker'; rmdir '$lock' 2>/dev/null" EXIT
  echo $$ > "$NUDGE_DIR/$name.worker"
  start=$(date +%s)
  while [ $(( $(date +%s) - start )) -lt "$NUDGE_GIVEUP" ]; do
    sleep "$NUDGE_RETRY"
    [ -e "$REG/$name.json" ] && has_unread "$name" || break     # read some other way: done
    [ $(( $(date +%s) - $(nudge_last "$name") )) -ge "$NUDGE_GAP" ] || continue
    st=$(agent_state "$name"); state="${st%%$'\t'*}"
    case "$state" in
      idle|unknown) nudge_now "$name" >/dev/null; [ $? = 1 ] || break;;
      busy|waiting) ;;      # its hooks deliver at the next turn boundary, or it resumes
      *) break;;            # dead / offline / unlocated: nothing to type into
    esac
  done
  rm -f "$NUDGE_DIR/$name.from"
}

cmd_nudge() { # name [text] [--force] — type a wake-up line + Enter (same guard as send)
  local name="" text="" force=0 tb ta why term sid
  while [ $# -gt 0 ]; do
    case "$1" in
      --force) force=1; shift;;
      *) if [ -z "$name" ]; then name="$1"; else text="$1"; fi; shift;;
    esac
  done
  [ -n "$name" ] || die 'usage: agent-chat nudge <name> [text] [--force]'
  local sock
  if [ "$(reg_get "$name" cli)" = claude ] && cc_inbound_accepts "$name" && sock=$(cc_inbox "$name"); then
    [ -n "$text" ] || text="[agent-chat] you have new messages — run: agent-chat read"
    $JQ -cn --arg t "$text" '{type:"user", message:{role:"user", content:$t}}' | nc -U -w 2 "$sock" >/dev/null 2>&1 \
      && { echo "ok (inbox)"; return; }
  fi
  sid=$(reg_get "$name" session_id)
  term=$(agent_term "$name") || return 1
  read -r tb ta <<< "$term"
  if [ "$force" = 0 ] && why=$(nudge_blocker "$tb" "$ta") && [ -n "$why" ]; then
    die "not nudging $name: $why — try again shortly, or --force"
  fi
  mkdir -p "$NUDGE_DIR"
  [ -n "$text" ] || text=$(nudge_text "$name")
  nudge_type "$name" "$tb" "$ta" "$text" "$sid" && date +%s > "$NUDGE_DIR/$name.last" && echo ok
}

cmd_type() { # name text — type into the input box WITHOUT submitting
  local name="${1:-}" text="${2:-}"
  [ -n "$name" ] && [ -n "$text" ] || die 'usage: agent-chat type <name> "text"'
  local tb ta term sid
  sid=$(reg_get "$name" session_id)
  term=$(agent_term "$name") || return 1
  read -r tb ta <<< "$term"
  control_type "$name" "$tb" "$ta" "$sid" "$text"
}

cmd_screen() { # name [N] — snapshot of the agent's visible terminal (last N lines)
  local name="${1:-}" n="${2:-0}"
  [ -n "$name" ] || die "usage: agent-chat screen <name> [N]"
  local tb ta out term
  term=$(agent_term "$name") || return 1
  read -r tb ta <<< "$term"
  out=$(term_screen "$tb" "$ta") || return 1
  # drop trailing blank lines; optionally keep only the last N
  out=$(printf '%s\n' "$out" | sed -e :a -e '/^[[:space:]]*$/{$d;N;ba' -e '}')
  if [ "$n" -gt 0 ] 2>/dev/null; then printf '%s\n' "$out" | tail -n "$n"; else printf '%s\n' "$out"; fi
}

cmd_key() { # name key... — send special keys / Claude Code shortcuts
  local name="${1:-}"; shift 2>/dev/null || true
  [ -n "$name" ] && [ $# -gt 0 ] || die "usage: agent-chat key <name> <key...>  (keys: escape enter ctrl-c ctrl-d ctrl-b ctrl-o ctrl-r ctrl-t ctrl-v tab shift-tab up down left right space backspace)"
  local tb ta k term sid
  sid=$(reg_get "$name" session_id)
  term=$(agent_term "$name") || return 1
  read -r tb ta <<< "$term"
  for k in "$@"; do
    control_key "$name" "$tb" "$ta" "$sid" "$k" >/dev/null || return 1
  done
  echo ok
}

cmd_spawn() { # <name> [--dir d] [--cmd "claude ..."] [--prompt "task"] [--tab|--pane] [--tmux]
  local name="" dir="$PWD" cmd="" task="" force_tmux=0 place="window"
  while [ $# -gt 0 ]; do
    case "$1" in
      --dir) dir="$2"; shift 2;;
      --cmd) cmd="$2"; shift 2;;
      --prompt) task="$2"; shift 2;;
      --tab) place="tab"; shift;;
      --pane) place="pane"; shift;;
      --tmux) force_tmux=1; shift;;
      -*) die "spawn: unknown arg '$1'";;
      *) [ -n "$name" ] && die "spawn: one name only"; name="$1"; shift;;
    esac
  done
  [ -n "$name" ] || die 'usage: agent-chat spawn <name> [--dir <path>] [--prompt "task"] [--cmd "claude ..."] [--tab|--pane] [--tmux]'
  printf '%s' "$name" | grep -Eq '^[a-z0-9][a-z0-9_-]{0,31}$' || die "invalid agent name '$name'"
  [ -d "$dir" ] || die "no such directory: $dir"

  # default launch command: reuse this session's own CLI flags (minus session
  # selectors), so e.g. --dangerously-skip-permissions carries over
  if [ -z "$cmd" ]; then
    # the nearest CLI above this command is the one spawning: launch the same
    local _ acmd
    while IFS=$'\t' read -r _ _ acmd; do
      case "$(cli_of_cmd "$acmd")" in
        claude)
          cmd=$(printf '%s' "$acmd" \
            | sed -E 's/ (--resume|-r|--session-id|--from-pr) [^ ]+//g; s/ (--resume|-r|--continue|-c|--fork-session|--from-pr)( |$)/ /g')
          break;;
        codex)    cmd="codex"; break;;      # (its flags live in config/profile, not on the daemon's command line)
        opencode) cmd="opencode"; break;;
      esac
    done <<< "$(ancestry)"
    [ -n "$cmd" ] || cmd="claude"
  fi

  local kickoff="You are a fresh agent. First, register on the local agent chat: agent-chat register $name — then check in with: agent-chat read."
  [ -n "$task" ] && kickoff="$kickoff Your task: $(printf '%s' "$task" | tr '\r\n' '  ')"
  # codex and claude take their first prompt as an argument: hand the kickoff
  # over on the command line, so nothing is typed into a booting TUI (startup
  # popups such as Codex's security notice swallow typed text, and the retries
  # below would pile keystrokes into the new window)
  local argkick=0
  case "$(cli_of_cmd "$cmd")" in codex|claude) argkick=1;; esac

  local sb sa own_cli own_sid own_tb="" own_ta="" own_src own
  # Relative placement needs the caller's verified pane, never the daemon's
  # inherited terminal or whichever window happens to be frontmost.
  if [ "$place" != window ]; then
    own=$(self_identity) || die "spawn: relative placement requires an unambiguous caller session"
    read -r own_cli own_sid <<< "$own"
    read -r own_tb own_ta own_src <<< "$(detect_term "$own_cli" "$own_sid" "")"
    [ -n "$own_tb" ] && [ "$own_tb" != none ] || die "spawn: can't prove the caller's pane for --$place; enable Codex thread-id titles or use a new window"
    [ "$force_tmux" = 0 ] || [ "$own_tb" = tmux ] || die "spawn: --tmux --$place requires the caller to be in tmux"
  fi
  if [ "$force_tmux" = 1 ] || [ "$own_tb" = tmux ] || { [ -z "$own_tb" ] && ! osascript -e 'tell application "iTerm2" to count windows' >/dev/null 2>&1; }; then
    command -v tmux >/dev/null || die "tmux not available and iTerm unreachable"
    sb="tmux"
    if [ "$own_tb" = tmux ]; then
      if [ "$place" = "pane" ]; then
        sa=$(tmux split-window -P -F '#{pane_id}' -t "$own_ta" -c "$dir")
      else
        sa=$(tmux new-window -P -F '#{pane_id}' -t "$own_ta" -c "$dir")
      fi
    else
      sa=$(tmux new-session -d -P -F '#{pane_id}' -s "agent-$name" -c "$dir" 2>/dev/null) \
        || sa=$(tmux new-session -d -P -F '#{pane_id}' -c "$dir")
    fi
    [ -n "$sa" ] || die "spawn: failed to create a new tmux pane — no input sent"
  else
    sb="iterm"
    # SAFETY: snapshot existing session ids — the id we get back for the new
    # tab/pane/window must be brand-new, or we'd type into a live session
    local existing myid
    existing=$(osascript <<'APPLESCRIPT'
set out to ""
tell application "iTerm2"
  repeat with w in windows
    repeat with t in tabs of w
      repeat with s in sessions of t
        set out to out & (id of s as text) & linefeed
      end repeat
    end repeat
  end repeat
end tell
return out
APPLESCRIPT
 ) || die "spawn: cannot snapshot iTerm sessions — nothing created"
    myid="$own_ta"
    case "$place" in
      pane)
        # split the spawner's own pane (object-based: no positional window refs)
        sa=$(osascript - "$myid" <<'APPLESCRIPT'
on run argv
  set myId to item 1 of argv
  tell application "iTerm2"
    repeat with w in windows
      repeat with t in tabs of w
        repeat with s in sessions of t
          if (id of s as text) is equal to myId then
            tell s to set newSess to (split vertically with default profile)
            return id of newSess
          end if
        end repeat
      end repeat
    end repeat
  end tell
  return ""
end run
APPLESCRIPT
)
        ;;
      tab)
        # new tab in the spawner's verified window; no frontmost fallback;
        # uses the returned tab OBJECT — a positional window reference can
        # re-resolve to a different window after z-order changes
        sa=$(osascript - "$myid" <<'APPLESCRIPT'
on run argv
  set myId to item 1 of argv
  tell application "iTerm2"
    repeat with w in windows
      repeat with t in tabs of w
        repeat with s in sessions of t
          if (id of s as text) is equal to myId then
            tell w to set newTab to (create tab with default profile)
            return id of current session of newTab
          end if
        end repeat
      end repeat
    end repeat
    error "verified caller pane no longer exists"
  end tell
end run
APPLESCRIPT
)
        ;;
      *)
        sa=$(osascript <<'APPLESCRIPT'
tell application "iTerm2"
  set newWin to (create window with default profile)
  delay 1
  return id of current session of newWin
end tell
APPLESCRIPT
)
        ;;
    esac
    [ -n "$sa" ] || die "failed to create iTerm $place"
    printf '%s\n' "$existing" | grep -qxF "$sa" \
      && die "SAFETY ABORT: '$sa' is a pre-existing session, not the new $place — refusing to type into it"
    sleep 1
    term_type "$sb" "$sa" "cd $(sq "$dir")" >/dev/null || die "spawn: could not type directory command"
    term_enter "$sb" "$sa" >/dev/null || die "spawn: directory command Enter failed"
  fi

  if [ "$argkick" = 1 ]; then term_type "$sb" "$sa" "$cmd $(sq "$kickoff")" >/dev/null || die "spawn: launch text failed"
  else term_type "$sb" "$sa" "$cmd" >/dev/null || die "spawn: launch text failed"; fi
  term_enter "$sb" "$sa" >/dev/null || die "spawn: launch Enter failed"

  # wait for the CLI process, then deliver the kickoff with verify-and-retry:
  # input typed during TUI startup (MCP servers still loading) gets swallowed
  local ttypath deadline try landed=0
  case "$sb" in
    tmux)  ttypath=$(tmux display -p -t "$sa" '#{pane_tty}');;
    iterm) ttypath="";;
  esac
  deadline=$((SECONDS + 45))
  while [ "$SECONDS" -lt "$deadline" ]; do
    if [ -n "$ttypath" ] && tty_has_cli "$ttypath" any; then break; fi
    [ -z "$ttypath" ] && [ "$SECONDS" -ge $((deadline - 37)) ] && break   # iterm: fixed ~8s boot wait
    sleep 2
  done
  local scr
  for try in 1 2 3 4; do
    sleep $((try * 4))
    scr=$(term_screen "$sb" "$sa" 2>/dev/null | tr -d '\n')
    # first-launch gate prompts appear before the input box exists and must be
    # cleared with Enter (accept default), NOT by typing the kickoff into them:
    #   "trust this folder" (new dir), "Yes, I trust", theme picker, etc.
    if printf '%s' "$scr" | grep -qiE "trust this folder|do you trust|Yes, I trust|Choose the text style|Select your theme"; then
      term_enter "$sb" "$sa" >/dev/null
      sleep 3
      continue   # re-inspect next iteration before sending the kickoff
    fi
    if [ "$argkick" = 1 ]; then   # given on the command line: only check it arrived, never retype
      printf '%s' "$scr" | grep -qE "fresh +agent" && { landed=1; break; }
      continue
    fi
    term_type "$sb" "$sa" "$kickoff" >/dev/null
    term_enter "$sb" "$sa" >/dev/null
    sleep 4
    # verify the prompt landed: its text must be on screen (joined against line wrap)
    if term_screen "$sb" "$sa" 2>/dev/null | tr -d '\n' | grep -qE "fresh +agent"; then landed=1; break; fi
  done

  echo "Spawned '$name' ($sb: $sa, dir: $dir)"
  echo "Launch: $cmd"
  if [ "$landed" = 1 ]; then
    echo "Kickoff delivered — it will register itself as '$name' (check: agent-chat who)"
  else
    echo "WARNING: kickoff prompt may not have landed — check: agent-chat screen $name"
  fi
}

# ---------- respawn (fresh session, same terminal, same name) ----------
#
# Replaces a tripped/dead agent IN PLACE: the old CLI process is killed by
# signal (nothing is ever typed into the tripped chat), and a FRESH session is
# started in the same pane with a kickoff that re-registers it under the same
# name — rebinding keeps its rooms and cursors, so peers see the same agent.
# It never opens a window (that is `spawn`), and it refuses unless it can
# prove the pane still belongs to the agent. There is no override for that
# proof: a pane it can't prove is never killed in or typed into.

RESPAWN_DIR="$BASE/respawn"
RESPAWN_LOG="$BASE/respawn.log"
RESPAWN_COOLDOWN=300   # seconds between two respawns of one agent (--ignore-cooldown overrides)

rlog() { mkdir -p "$RESPAWN_DIR"; echo "[$(date '+%F %T')] $*" >> "$RESPAWN_LOG"; }

# sq <string> — single-quote for a POSIX shell (zsh/bash), byte-exact.
# (Not printf %q: bash 3.2 escapes multi-byte UTF-8 into a mix of raw and
# octal bytes, which iTerm's AppleScript rejects as invalid text.)
sq() { local s="$1" q="'"; s=${s//$q/$q\\$q$q}; printf '%s%s%s' "$q" "$s" "$q"; }

agent_pids() { # tty-path cli -> pids of the TOP-LEVEL processes of that agent CLI on the tty
  local rows pid ppid cmd mine="" e
  rows=$(ps -t "${1#/dev/}" -o pid=,ppid=,command= 2>/dev/null)
  while read -r pid ppid cmd; do
    [ -n "$pid" ] || continue
    [ "$(cli_of_cmd "$cmd")" = "$2" ] || continue
    [ "$2" != codex ] || codex_tui_cmd "$cmd" || continue
    mine="$mine $pid:$ppid"
  done <<< "$rows"
  for e in $mine; do
    case " $mine " in *" ${e#*:}:"*) continue;; esac   # child of another match (npm wrapper, tool)
    echo "${e%%:*}"
  done
}

tty_fg_shell() { # tty-path — rc 0 when the tty's foreground process group is an interactive shell
  local fg c
  fg=$(ps -t "${1#/dev/}" -o stat=,comm= 2>/dev/null | awk '$1 ~ /\+/ {print $2}')
  [ -n "$fg" ] || return 1
  while read -r c; do
    case "${c##*/}" in zsh|-zsh|bash|-bash|fish|-fish|sh|-sh) ;; *) return 1;; esac
  done <<< "$fg"
  return 0
}

pane_taken_by_other() { # name backend addr -> prints the other agent registered LATER on this pane
  $JQ -r --arg me "$1" --arg tb "$2" --arg ta "$3" --arg reg "$(reg_get "$1" registered_at)" \
    'select(.name != $me and .term_backend == $tb and .term_addr == $ta and (.registered_at // "") > $reg) | .name' \
    "$REG"/*.json 2>/dev/null | head -n1
}

cmd_respawn() ( # <name> [--prompt "task"] [--cmd "codex ..."] [--report-to <name>] [--force-busy] [--ignore-cooldown] [--no-wait] [--dry-run]
  local name="" task="" cmd="" report="" force_busy=0 nocool=0 wait=1 dry=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --prompt) task="$2"; shift 2;;
      --cmd) cmd="$2"; shift 2;;
      --report-to) report="$2"; shift 2;;
      --force-busy) force_busy=1; shift;;
      --ignore-cooldown) nocool=1; shift;;
      --no-wait) wait=0; shift;;
      --dry-run) dry=1; shift;;
      -*) die "respawn: unknown arg '$1'";;
      *) [ -n "$name" ] && die "respawn: one name only"; name="$1"; shift;;
    esac
  done
  [ -n "$name" ] || die 'usage: agent-chat respawn <name> [--prompt "task"] [--cmd "codex ..."] [--report-to <name>] [--force-busy] [--ignore-cooldown] [--no-wait] [--dry-run]'
  [ -e "$REG/$name.json" ] || die "no agent named '$name' is registered"
  local cli sid cwd tb ta term rc tty title pids p pp last other
  cli=$(reg_get "$name" cli); sid=$(reg_get "$name" session_id); cwd=$(reg_get "$name" cwd)
  case "$cli" in codex|claude) ;; *) die "respawn: '$name' is a '$cli' agent — only codex and claude agents can be respawned";; esac
  [ -d "$cwd" ] || cwd="$HOME"
  [ -n "$cmd" ] || cmd="$cli"
  if [ -z "$report" ]; then report=$(resolve_name 2>/dev/null) || report=""; [ "$report" = "$name" ] && report=""; fi

  last=$(cat "$RESPAWN_DIR/$name.last" 2>/dev/null || echo 0)
  if [ "$nocool" = 0 ] && [ $(( $(date +%s) - last )) -lt "$RESPAWN_COOLDOWN" ]; then
    die "respawn: '$name' was respawned $(( $(date +%s) - last ))s ago (cooldown ${RESPAWN_COOLDOWN}s) — look at it first: agent-chat screen $name"
  fi

  # Serialize replacements of one identity. A dry run acquires no lock.
  if [ "$dry" = 0 ]; then
    mkdir -p "$RESPAWN_DIR"
    local lock="$RESPAWN_DIR/$name.lock"
    mkdir "$lock" 2>/dev/null || die "respawn: another replacement of '$name' is in progress"
    trap 'rmdir "$lock" 2>/dev/null' EXIT
    trap 'exit 1' HUP INT TERM
  fi

  warm_terms || die "respawn: can't list the terminals right now — nothing was touched"
  term=$(resolve_term "$name"); rc=$?
  [ "$rc" = 0 ] || die "respawn: can't prove '$name''s current pane — nothing was touched; enable thread-id titles before using terminal recovery"
  read -r tb ta <<< "$term"
  other=$(pane_taken_by_other "$name" "$tb" "$ta")
  [ -z "$other" ] || die "respawn: pane was taken over by '$other' — refusing"
  tty=$(agent_tty "$tb" "$ta"); [ -n "$tty" ] || die "respawn: pane closed"
  title=$(term_title "$tb" "$ta")
  local proof="" born="" parent="" pb=""
  pids=$(agent_pids "$tty" "$cli")
  if [ -z "$pids" ]; then
    saved_shell_proof "$name" "$tb" "$ta" || die "respawn: no running session and no verified unchanged shell — refusing"
    parent=$(reg_get "$name" term_shell_pid); pb=$(reg_get "$name" term_shell_birth)
  else
    proof=$(session_proof "$cli" "$sid" "$tb" "$ta") || die "respawn: current foreground CLI isn't provably session $sid — refusing"
    read -r tty p born parent pb <<< "$proof"
    is_shell_pid "$parent" || die "respawn: CLI isn't running under a shell; killing it could close the pane"
    if [ "$force_busy" = 0 ]; then
      local scr
      scr=$(term_screen "$tb" "$ta" 2>/dev/null | grep -v '^[[:space:]]*$' | tail -n 25)
      if [ "$(glyph_state "$title")" = busy ] || printf '%s' "$scr" | grep -q 'esc to interrupt'; then
        die "respawn: '$name' looks BUSY — refusing (--force-busy if truly stuck)"
      fi
    fi
  fi

  # 3. build + validate the launch line BEFORE anything is killed
  local kickoff launch
  task=$(printf '%s' "$task" | tr '\r\n' '  ')
  kickoff="You are a FRESH session replacing agent '$name' (its previous session tripped or died and was restarted in this same terminal). First run: agent-chat register $name - then run: agent-chat read."
  if [ -n "$task" ]; then
    kickoff="$kickoff Your task: $task"
  elif [ -n "$report" ]; then
    kickoff="$kickoff Then tell $report you are back: agent-chat send --to $report \"$name: respawned as a fresh session, ready for a task\" - and wait for instructions."
  else
    kickoff="$kickoff Then wait for instructions in the chat."
  fi
  launch="reset; cd $(sq "$cwd") && $cmd $(sq "$kickoff")"
  printf '%s' "$launch" | iconv -f UTF-8 -t UTF-8 >/dev/null 2>&1 || die "respawn: launch line is not valid UTF-8 — nothing was touched"

  if [ "$dry" = 1 ]; then
    echo "DRY RUN — would respawn '$name': pane $tb $ta ($tty), kill $cli pid(s) ${pids:-none (already dead)}, then type: $launch"
    return 0
  fi
  mkdir -p "$RESPAWN_DIR"
  rlog "$name: respawn (cli=$cli tty=$tty pane=$tb $ta old=$sid report=${report:-none} pids=${pids:-none})"
  date +%s > "$RESPAWN_DIR/$name.last"

  # Signal only the captured process, and re-prove ownership before escalation.
  # Never rediscover and kill whichever replacement happens to occupy its tty.
  if [ -n "$pids" ]; then
    [ "$(reg_get "$name" session_id)" = "$sid" ] && \
      [ "$(session_proof "$cli" "$sid" "$tb" "$ta")" = "$proof" ] || die "respawn: ownership changed before stop — refusing"
    kill -TERM "$p" 2>/dev/null || die "respawn: could not signal captured CLI"
    local i=0
    while [ "$i" -lt 10 ] && same_process "$p" "$born"; do sleep 1; i=$((i + 1)); done
    if same_process "$p" "$born"; then
      [ "$(reg_get "$name" session_id)" = "$sid" ] && \
        [ "$(session_proof "$cli" "$sid" "$tb" "$ta")" = "$proof" ] || die "respawn: ownership changed before escalation — refusing"
      rlog "$name: still alive after SIGTERM — SIGKILL captured pid $p"
      kill -KILL "$p" 2>/dev/null || die "respawn: could not kill captured CLI"
      sleep 2
      same_process "$p" "$born" && die "respawn: captured CLI is still alive"
    fi
  fi
  [ "$(reg_get "$name" session_id)" = "$sid" ] || die "respawn: identity rebound while stopping — refusing to launch"
  shell_proof "$tb" "$ta" "$tty" "$parent" "$pb" || die "respawn: old session stopped, but the original shell isn't ready — no input sent"

  # 5. fresh session in the same pane; the kickoff rides on the command line
  #    (nothing is typed into a booting TUI, where popups would swallow it)
  term_type "$tb" "$ta" "$launch" >/dev/null 2>&1 || { rlog "$name: ABORT typing the launch line failed"; die "respawn: old session stopped, but typing the launch line failed — the pane is at a bare shell"; }
  [ "$tb" != tmux ] || sleep 1
  shell_proof "$tb" "$ta" "$tty" "$parent" "$pb" || die "respawn: original shell changed before Enter — launch was not submitted"
  term_key "$tb" "$ta" enter >/dev/null 2>&1 || die "respawn: launch Enter failed"
  local deadline=$((SECONDS + 30)) npid=""
  while [ "$SECONDS" -lt "$deadline" ]; do
    sleep 2; npid=$(agent_pids "$tty" "$cli"); [ -n "$npid" ] && break
  done
  if [ -z "$npid" ]; then
    rlog "$name: FAILED no new $cli process after 30s"
    echo "FAILED: old session stopped, but no new $cli started in $tty within 30s — look: agent-chat screen $name"
    return 2
  fi
  rlog "$name: fresh $cmd running (pid $npid) in $tb $ta"
  echo "Respawned '$name' in its own pane ($tb $ta, $tty): old session $sid stopped, fresh $cmd running (pid $npid) in $cwd."
  [ "$wait" = 1 ] || { echo "Not waiting for it to re-register (--no-wait)."; return 0; }

  # 6. confirm: the name must be rebound to a NEW session
  local nsid=""
  deadline=$((SECONDS + 180))
  while [ "$SECONDS" -lt "$deadline" ]; do
    sleep 5
    nsid=$(reg_get "$name" session_id)
    if [ -n "$nsid" ] && [ "$nsid" != "$sid" ]        && [ "$(reg_get "$name" term_backend) $(reg_get "$name" term_addr)" = "$tb $ta" ]        && session_proof "$cli" "$nsid" "$tb" "$ta" >/dev/null; then break; fi
    nsid=""
  done
  if [ -n "$nsid" ]; then
    rlog "$name: re-registered as session $nsid"
    echo "Re-registered: '$name' -> session $nsid (pane $(reg_get "$name" term_addr), found via $(reg_get "$name" term_src))."
  else
    rlog "$name: WARNING not re-registered after 180s"
    echo "WARNING: '$name' has not re-registered after 180s — look: agent-chat screen $name"
    return 1
  fi
)

# ---------- watch (blocking fleet watchdog) ----------
#
# Built to run as a BACKGROUND shell of the orchestrating agent (OpenCode
# `shell` with background:true, Claude Code run_in_background): it polls the
# named agents and EXITS as soon as something needs attention, printing a
# report — the harness then wakes the orchestrator with that output. The
# orchestrator handles it and re-arms the watch (the report ends with the
# exact command). Each condition is reported once per session (signatures in
# $BASE/watch/), so re-arming never re-fires on the same screen.
#
# Trips (with --respawn: replaced in place by `respawn`, then reported):
#   dead    — the pane is at a shell prompt: its agent CLI exited/crashed
#   filter  — Codex content gate: the unindented "ⓘ This content can't be
#             shown" block with its "Apply for Daybreak" line, on an idle
#             screen (tool output is always indented, so an agent merely
#             printing the phrase doesn't match)
# Reported only (the orchestrator decides):
#   error   — stream disconnected / retry limit / bad status
#   limit   — usage limit hit (a respawn would not help)
#   paste   — a pasted prompt stuck unsent in the input box
#   idle    — idle longer than --idle-alert minutes (it may have just stopped)
#   offline — its pane was closed / it is gone

WATCH_DIR="$BASE/watch"

# watch_classify <screen-tail> -> "kind<TAB>matched line" ("" when clean).
# A working screen ('esc to interrupt') is never classified.
watch_classify() {
  local s="$1" m
  printf '%s' "$s" | grep -q 'esc to interrupt' && return 0
  m=$(printf '%s' "$s" | grep -E "^[[:space:]]?ⓘ +This content can[^ ]{1,3}t be shown" | tail -n1)
  if [ -n "$m" ] && printf '%s' "$s" | grep -q "Apply for Daybreak"; then printf 'filter\t%s\n' "$m"; return 0; fi
  m=$(printf '%s' "$s" | grep -iE "You.ve hit your usage limit|Goal hit usage limits" | tail -n1)
  [ -n "$m" ] && { printf 'limit\t%s\n' "$m"; return 0; }
  m=$(printf '%s' "$s" | grep -E "^[[:space:]]?[■⚠✗].*(stream disconnected before completion|exceeded retry limit|unexpected status [45][0-9][0-9])" | tail -n1)
  [ -n "$m" ] && { printf 'error\t%s\n' "$m"; return 0; }
  m=$(printf '%s' "$s" | grep -E "^› .*\[Pasted Content [0-9]+ chars\]" | tail -n1)
  [ -n "$m" ] && { printf 'paste\t%s\n' "$m"; return 0; }
  return 0
}

cmd_watch() { # <name...> [--interval S] [--idle-alert MIN] [--respawn] [--report-to <name>]
  local names="" interval=60 idle_min=0 respawn=0 report="" argv="$*"
  while [ $# -gt 0 ]; do
    case "$1" in
      --interval) interval="$2"; shift 2;;
      --idle-alert) idle_min="$2"; shift 2;;
      --respawn) respawn=1; shift;;
      --report-to) report="$2"; shift 2;;
      -*) die "watch: unknown arg '$1'";;
      *) [ -e "$REG/$1.json" ] || die "watch: no agent named '$1' is registered"; names="$names $1"; shift;;
    esac
  done
  [ -n "$names" ] || die 'usage: agent-chat watch <name...> [--interval 60] [--idle-alert MIN] [--respawn] [--report-to <name>]'
  if [ -z "$report" ]; then report=$(resolve_name 2>/dev/null) || report=""; fi
  mkdir -p "$WATCH_DIR"
  echo "[$(date '+%T')] watching:$names (every ${interval}s$([ "$respawn" = 1 ] && echo ', auto-respawn on dead/filter')$([ "$idle_min" -gt 0 ] && echo ", idle alert ${idle_min}m"))"

  local n st state why sid scr cls kind line sig prev pend events="" hstate hepoch=0 out tb ta rout rrc blind=0
  while :; do
    date +%s > "$WATCH_DIR/heartbeat"
    # no trustworthy view of the terminals: judge nothing this poll (a failed
    # snapshot would make every agent look offline); say so if it persists
    if ! warm_terms; then
      blind=$((blind + 1))
      if [ "$blind" = 10 ]; then
        echo "[$(date '+%T')] agent-chat watch — needs attention:
- (watch itself): can't read the terminals for 10 polls in a row (iTerm AppleScript failing) — agents are NOT being watched.

Re-arm (as a background shell again): agent-chat watch $argv"
        return 0
      fi
      sleep "$interval"; continue
    fi
    blind=0
    for n in $names; do
      [ -e "$REG/$n.json" ] || continue
      st=$(agent_state "$n"); state="${st%%$'\t'*}"; why="${st#*$'\t'}"
      sid=$(reg_get "$n" session_id)
      kind=""; line=""
      case "$state" in
        dead)    kind=dead;;
        offline) kind=offline;;
        unlocated) kind=unlocated; line="$why";;
        busy) ;;
        *)
          tb=""; ta=""
          read -r tb ta <<< "$(resolve_term "$n" 2>/dev/null)"
          if [ -n "$ta" ]; then
            scr=$(term_screen "$tb" "$ta" 2>/dev/null | grep -v '^[[:space:]]*$' | tail -n 16)
            cls=$(watch_classify "$scr")
            if [ -n "$cls" ]; then kind="${cls%%$'\t'*}"; line="${cls#*$'\t'}"; fi
          fi
          if [ -z "$kind" ] && [ "$idle_min" -gt 0 ] && [ "$state" = idle ] && [ -f "$STATUS/$n" ]; then
            read -r hstate hepoch < "$STATUS/$n"
            if [ "$hstate" = idle ] && [ $(( $(date +%s) - hepoch )) -ge $(( idle_min * 60 )) ]; then
              kind=idle; line="$hepoch"
            fi
          fi;;
      esac
      # clean poll: the condition is over — a later recurrence is a new event
      [ -n "$kind" ] || { rm -f "${WATCH_DIR:?}/${n:?}.pending" "${WATCH_DIR:?}/${n:?}.reported"; continue; }
      sig="$kind|$sid|$line"
      prev=$(cat "$WATCH_DIR/$n.reported" 2>/dev/null)
      [ "$sig" = "$prev" ] && continue
      # every condition must hold on two polls in a row: not a frame mid-redraw,
      # not one bad terminal snapshot (idle is already a long-lived condition)
      case "$kind" in
        dead|offline|unlocated|filter|error|limit|paste)
          pend=$(cat "$WATCH_DIR/$n.pending" 2>/dev/null)
          [ "$pend" = "$sig" ] || { printf '%s' "$sig" > "$WATCH_DIR/$n.pending"; continue; };;
      esac
      rm -f "${WATCH_DIR:?}/${n:?}.pending"
      printf '%s' "$sig" > "$WATCH_DIR/$n.reported"
      case "$kind" in
        dead)    out="DEAD — its $(reg_get "$n" cli) exited/crashed ($why)";;
        offline) out="OFFLINE — $why";;
        unlocated) out="UNLOCATED — cannot watch this worker ($why); terminal control and auto-respawn are disabled";;
        filter)  out="CONTENT-FILTER TRIP — the chat is gated (do NOT type into it)";;
        error)   out="ERROR — $(printf '%s' "$line" | sed 's/^[[:space:]]*//' | cut -c1-160)";;
        limit)   out="USAGE LIMIT — a respawn won't help until it resets";;
        paste)   out="STUCK INPUT — a pasted prompt sits unsent in its input box";;
        idle)    out="IDLE for $(( ($(date +%s) - hepoch) / 60 ))m — it may have stopped without reporting";;
      esac
      if [ "$respawn" = 1 ] && { [ "$kind" = dead ] || [ "$kind" = filter ]; }; then
        rout=$( (cmd_respawn "$n" --no-wait ${report:+--report-to "$report"}) 2>&1 ); rrc=$?
        out="$out
    -> respawn: $(printf '%s' "$rout" | tr '\n' ' ')"
        [ "$rrc" = 0 ] && rm -f "${WATCH_DIR:?}/${n:?}.reported"   # a fresh session starts with a clean slate
        warm_terms || true
      fi
      events="$events
- $n: $out"
    done
    if [ -n "$events" ]; then
      echo "[$(date '+%T')] agent-chat watch — needs attention:$events"
      echo
      echo "Look closer: agent-chat screen <name> · replace one by hand: agent-chat respawn <name> [--prompt \"task\"]"
      echo "A respawned agent is a FRESH session: give it its task (agent-chat send --to <name> \"...\")."
      echo "Re-arm (as a background shell again): agent-chat watch $argv"
      return 0
    fi
    sleep "$interval"
  done
}

# ---------- web viewer ----------

cmd_web() { # [port] — serve the read-only chat viewer UI on localhost
  local port="${1:-8787}" self dir
  self=$(readlink -f "$0" 2>/dev/null || echo "$0")
  dir=$(dirname "$self")
  [ -f "$dir/chat-viewer.py" ] || die "chat-viewer.py not found next to $self"
  exec python3 "$dir/chat-viewer.py" --port "$port"
}

# ---------- codex setup ----------

cmd_setup_codex() {
  # Wire agent-chat delivery + status hooks into OpenAI Codex CLI (>= 0.145),
  # which uses a Claude-Code-compatible hooks system at ~/.codex/hooks.json.
  local HK="$HOME/.codex/hooks.json" AC="$HOME/.claude/agent-chat/agent-chat" title_id=0
  [ "${1:-}" = "--title-id" ] && title_id=1
  command -v codex >/dev/null || die "codex CLI not found on PATH"
  [ -x "$AC" ] || die "agent-chat runtime not found at $AC"
  [ -f "$HK" ] || echo '{"hooks":{}}' > "$HK"
  cp "$HK" "$HK.bak-agentchat-setup"
  local ev added=0
  for ev in UserPromptSubmit PostToolUse Stop PermissionRequest; do
    if $JQ -e --arg ev "$ev" --arg ac "$AC" \
        '.hooks[$ev][]?.hooks[]? | select(.command | startswith($ac))' "$HK" >/dev/null 2>&1; then
      echo "  $ev: already installed"
      continue
    fi
    $JQ --arg ev "$ev" --arg cmd "$AC hook $ev" \
      '.hooks[$ev] = ((.hooks[$ev] // []) + [{"hooks":[{"type":"command","command":$cmd,"timeout":10}]}])' \
      "$HK" > "$HK.tmp" && mv "$HK.tmp" "$HK"
    echo "  $ev: installed"
    added=1
  done
  # No feature flag is needed. `plugin_hooks = true` (which this installer
  # used to ask for) changes nothing: on Codex 0.154 and 0.162 the hooks panel
  # lists the same hooks as active with it set to false, and 0.162 raises no
  # warning about it. An existing line in config.toml can simply stay.
  echo
  if [ "$added" = 1 ]; then
    echo "Done (backup: $HK.bak-agentchat-setup)."
    echo "NOTE: Codex requires a one-time interactive approval per new hook —"
    echo "start/prompt a Codex session and approve the agent-chat hooks when asked."
  else
    echo "Nothing to do — all four hooks were already installed."
  fi
  echo "Codex agents register with: agent-chat register <name>  (identity via \$CODEX_THREAD_ID)"
  echo
  if [ "$title_id" = 1 ]; then
    codex_title_id
  elif ! grep -Eq '^ *terminal_title *=.*thread-id' "$HOME/.codex/config.toml" 2>/dev/null; then
    echo "Required for Codex terminal control: 'agent-chat setup-codex --title-id'."
    echo "Codex runs commands in a shared background daemon, so a Codex agent can't see which pane"
    echo "it is in; agent-chat requires a unique current thread-id title to locate it."
    echo "With the id in the title it is exact, and survives moving the session to another pane."
  fi
}

# Put "thread-id" into [tui] terminal_title in ~/.codex/config.toml (backup kept).
# New Codex sessions then carry their thread id in the terminal title, which
# codex_locate reads back — the one exact link from a thread to its pane.
codex_title_id() {
  local CFG="$HOME/.codex/config.toml"
  [ -f "$CFG" ] || die "no $CFG"
  command -v python3 >/dev/null || die "python3 needed to edit $CFG — add \"thread-id\" to [tui] terminal_title by hand"
  python3 - "$CFG" <<'PY'
import re, shutil, sys
path = sys.argv[1]
src = open(path).read()
lines = src.split("\n")
start = next((i for i, l in enumerate(lines) if l.strip() == "[tui]"), None)
DEFAULT = 'terminal_title = ["activity", "thread-name", "project", "thread-id"]'
if start is None:
    lines += ["", "[tui]", DEFAULT]
    what = "added a [tui] table with " + DEFAULT
else:
    end = next((i for i in range(start + 1, len(lines)) if lines[i].lstrip().startswith("[")), len(lines))
    idx = next((i for i in range(start + 1, end) if re.match(r"\s*terminal_title\s*=", lines[i])), None)
    if idx is None:
        lines.insert(start + 1, DEFAULT)
        what = "added " + DEFAULT
    elif "thread-id" in lines[idx]:
        print("  terminal_title: thread-id already present — nothing to do"); sys.exit(0)
    elif re.search(r"\[[^\]]*\]\s*(#.*)?$", lines[idx]):
        lines[idx] = re.sub(r"\s*\]", ', "thread-id"]', lines[idx], count=1)
        what = "appended \"thread-id\" to your terminal_title"
    else:
        sys.exit("  terminal_title spans several lines — add \"thread-id\" to it by hand in " + path)
shutil.copy2(path, path + ".bak-agentchat-title")
open(path, "w").write("\n".join(lines))
print("  " + what + " (backup: " + path + ".bak-agentchat-title)")
print("  Takes effect in Codex sessions started from now on.")
PY
}

# ---------- hook mode ----------

cmd_hook() {
  local event="$1" input sid name text payload
  input=$(cat)
  local files=("$REG"/*.json)
  [ -e "${files[0]}" ] || exit 0
  sid=$(printf '%s' "$input" | $JQ -r '.session_id // empty' 2>/dev/null)
  [ -n "$sid" ] || exit 0
  name=$(resolve_name "$sid") || exit 0
  local pmode; pmode=$(printf '%s' "$input" | $JQ -r '.permission_mode // empty' 2>/dev/null)
  [ -n "$pmode" ] && { mkdir -p "$STATUS"; printf '%s\n' "$pmode" > "$STATUS/$name.mode"; }
  # stamp coarse state from the event (fallback signal; the live title glyph is
  # primary). Runs BEFORE the no-mail early-exit so it always records.
  case "$event" in
    UserPromptSubmit|PostToolUse|PreToolUse) stamp_status "$name" busy;;
    Stop|SubagentStop)                       stamp_status "$name" idle;;
    PermissionRequest)                       stamp_status "$name" waiting;;
    # (Notification is intentionally NOT mapped — it also fires on idle, so it
    #  would mislabel an idle agent as "waiting".)
  esac
  text=$(deliver "$name")
  [ -n "$text" ] || exit 0
  payload=$(mail_payload "$name" "$text")
  case "$event" in
    Stop)
      $JQ -n --arg r "$payload
If nothing is actionable, acknowledge briefly and stop." '{decision:"block", reason:$r}'
      ;;
    UserPromptSubmit|PostToolUse)
      $JQ -n --arg e "$event" --arg t "$payload" \
        '{hookSpecificOutput:{hookEventName:$e, additionalContext:$t}}'
      ;;
    *) exit 0;;
  esac
}

# ---------- main ----------

AS_NAME=""
ARGS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --as) AS_NAME="$2"; shift 2;;
    *) ARGS+=("$1"); shift;;
  esac
done
set -- "${ARGS[@]}"

cmd="${1:-help}"; shift 2>/dev/null || true
case "$cmd" in
  register)   cmd_register "$@";;
  unregister) cmd_unregister "$@";;
  send)       cmd_send "$@";;
  read)       cmd_read "$@";;
  log)        cmd_log "$@";;
  rooms)      cmd_rooms "$@";;
  join)       cmd_join "$@";;
  leave)      cmd_leave "$@";;
  peek)       cmd_peek "$@";;
  who)        cmd_who "$@";;
  status)     cmd_status "$@";;
  nudge)      cmd_nudge "$@";;
  _nudge-worker) cmd_nudge_worker "$@";;
  type)       cmd_type "$@";;
  key)        cmd_key "$@";;
  screen)     cmd_screen "$@";;
  spawn)      cmd_spawn "$@";;
  respawn)    cmd_respawn "$@";;
  watch)      cmd_watch "$@";;
  setup-codex) cmd_setup_codex "$@";;
  whereami)   cmd_whereami "$@";;
  _session-proof) session_proof "$@";;
  _shell-proof) shell_proof "$@";;
  _process-token) process_token "$@";;
  web)        cmd_web "$@";;
  hook)       cmd_hook "$@";;
  help|--help|-h)
    awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0";;
  *) die "unknown command '$cmd' (try: agent-chat help)";;
esac; exit $?   # same line as esac: bash reads a script lazily, so a long-running
                # command (watch) must never read on into a file edited under it
